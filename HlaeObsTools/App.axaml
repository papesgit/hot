<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HlaeObsTools"
             xmlns:conv="using:HlaeObsTools.Converters"
             x:Class="HlaeObsTools.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://HlaeObsTools/Themes/ScrubbyNumericField.axaml"/>
        <Style Selector="Button, ToggleSwitch, CheckBox">
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <DockFluentTheme />
    </Application.Styles>

    <Application.Resources>
        <conv:RelativeToCanvasConverter x:Key="RelativeToCanvasConverter" />
        <conv:BooleanNegationConverter x:Key="BooleanNegationConverter" />
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
</Application>
