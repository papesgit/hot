<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        x:Class="HlaeObsTools.Views.DockHostWindow"
        Width="800"
        Height="600"
        MinWidth="400"
        MinHeight="300"
        Background="#1E1E1E"
        Title="HLAE Observer">
    <Grid Name="RootGrid">
        <dock:DockControl Name="DockControl"/>

        <Grid IsHitTestVisible="False"
              Panel.ZIndex="9999">
            <Canvas Name="HotkeyOverlayCanvas">
                <Border Name="HotkeyHoverOutline"
                        IsVisible="False"
                        BorderBrush="#FF4CC2FF"
                        BorderThickness="2"
                        Background="#334CC2FF"
                        CornerRadius="4"/>
            </Canvas>

            <Border Name="HotkeyStatusPanel"
                    IsVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#E6191C22"
                    BorderBrush="#FF4CC2FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6">
                <TextBlock Name="HotkeyStatusText"
                           Foreground="White"
                           FontSize="13"
                           Text="Hotkey mode"/>
            </Border>
        </Grid>
    </Grid>
</Window>
