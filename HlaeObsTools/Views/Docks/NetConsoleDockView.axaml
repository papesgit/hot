<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HlaeObsTools.ViewModels.Docks"
             xmlns:svg="using:Avalonia.Svg.Skia"
             x:Class="HlaeObsTools.Views.Docks.NetConsoleDockView"
             x:DataType="vm:NetConsoleDockViewModel">
  <Border Background="#1E1E1E" Padding="10" Focusable="True">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
      <Grid ColumnDefinitions="Auto,180,*,Auto" ColumnSpacing="8">
        <TextBlock Text="Address"
                   VerticalAlignment="Center"
                   Foreground="#D0D0D0" />
        <TextBox Grid.Column="1"
                 Text="{Binding HostPortText, Mode=TwoWay}"
                 HorizontalAlignment="Stretch"
                 MinWidth="140"
                 VerticalContentAlignment="Center"
                 Background="#2A2A2A"
                 Foreground="#E0E0E0"
                 BorderBrush="#3A3A3A" />
        <TextBlock Grid.Column="2"
                   Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   Foreground="#8AC6FF" />
        <Button Grid.Column="3"
                Content="{Binding ConnectionButtonText}"
                Command="{Binding ToggleConnectionCommand}"
                IsEnabled="{Binding CanToggleConnection}"
                MinWidth="110"
                Background="#3C6DD2"
                Foreground="White" />
      </Grid>

      <Border Grid.Row="1" Focusable="True"
              Background="#121212"
              BorderBrush="#2E2E2E"
              BorderThickness="1"
              Padding="6">
        <ListBox x:Name="LogListBox"
                 ItemsSource="{Binding LogLines}"
                 SelectionMode="Multiple"
                 KeyDown="OnLogKeyDown"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="#E0E0E0"
                 Padding="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="0" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="ListBoxItem:selected">
              <Setter Property="Background" Value="#233247" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         FontFamily="Consolas, 'Cascadia Mono', monospace"
                         Margin="0"
                         TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="4">
        <Border IsVisible="{Binding HasSuggestions}"
                Background="#121212"
                BorderBrush="#2E2E2E"
                BorderThickness="1"
                Padding="4"
                CornerRadius="2">
          <ListBox x:Name="SuggestionListBox"
                   ItemsSource="{Binding Suggestions}"
                   SelectedIndex="{Binding SelectedSuggestionIndex, Mode=TwoWay}"
                   SelectionChanged="OnSuggestionSelectionChanged"
                   DoubleTapped="OnSuggestionDoubleTapped"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="#E0E0E0"
                   MaxHeight="220">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}"
                             FontFamily="Consolas, 'Cascadia Mono', monospace"
                             FontSize="14" />
                  <TextBlock Text="{Binding Description}"
                             IsVisible="{Binding HasDescription}"
                             FontSize="12"
                             Foreground="#9AA5B1"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox x:Name="InputBox"
                   Text="{Binding InputText, Mode=TwoWay}"
                   Watermark="Type a console command..."
                   Background="#2A2A2A"
                   Foreground="#E0E0E0"
                   BorderBrush="#3A3A3A"
                   VerticalContentAlignment="Center"
                   KeyDown="OnInputKeyDown" />
          <Button Grid.Column="1"
                  Content="Send"
                  Command="{Binding SendCommand}"
                  Background="#3C6DD2"
                  Foreground="White" />
          <Button x:Name="SettingsButton"
                  Grid.Column="2"
                  Width="26"
                  Height="26"
                  Padding="8"
                  Background="#2A2A2A"
                  BorderBrush="#3A3A3A">
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedRight">
                <MenuItem Header="Filter game events"
                          ToggleType="CheckBox"
                          IsChecked="{Binding FilterGameEvents, Mode=TwoWay}" />
                <MenuItem Header="Filter unknown net messages"
                          ToggleType="CheckBox"
                          IsChecked="{Binding FilterUnknownNetMessages, Mode=TwoWay}" />
              </MenuFlyout>
            </Button.Flyout>
            <svg:Svg Path="avares://HlaeObsTools/Assets/icons/settings.svg"
                     Width="16"
                     Height="16" />
          </Button>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
