<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HlaeObsTools.ViewModels.Docks"
             xmlns:ctrls="using:HlaeObsTools.Controls"
             xmlns:views="using:HlaeObsTools.Views"
             xmlns:conv="using:HlaeObsTools.Converters"
             xmlns:ac="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="HlaeObsTools.Views.Docks.VideoDisplayDockView"
             x:Name="Root"
             x:DataType="vm:VideoDisplayDockViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video display area -->
        <Grid Grid.Row="0" ClipToBounds="True">
            <Border Background="Black" Focusable="True"
                    x:Name="VideoContainer">
                <Grid>
                    <!-- Native RTP swapchain child window -->
                    <Grid x:Name="RtpSwapchainWrapper"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.IsVisible>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <conv:BooleanAndConverter/>
                                </MultiBinding.Converter>
                                <Binding Path="!UseD3DHost"/>
                                <Binding Path="IsStreaming"/>
                            </MultiBinding>
                        </Grid.IsVisible>
                        <Grid x:Name="RtpSwapchainAspect"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <ctrls:RtpSwapchainHost x:Name="RtpSwapchainHost"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
                        </Grid>
                    </Grid>

                    <!-- Native HWND shared texture (uses overlay window for HUD) -->
                    <Grid x:Name="SharedTextureWrapper"
                          IsVisible="{Binding UseD3DHost}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid x:Name="SharedTextureAspect"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <ctrls:D3DSharedTextureHost x:Name="SharedTextureHost"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Focusable="True"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- HUD overlay with freecam indicator and speed scale (only when NOT using D3DHost - overlay window used instead) -->
            <views:HudOverlayContent x:Name="HudContent"
                                     ZIndex="10"
                                     DataContext="{Binding HudOverlay}">
                <views:HudOverlayContent.IsVisible>
                    <MultiBinding>
                        <MultiBinding.Converter>
                            <conv:BooleanAndConverter/>
                        </MultiBinding.Converter>
                        <Binding Path="ShowNativeHud"/>
                        <Binding Path="DataContext.UseD3DHost"
                                 ElementName="Root"
                                 Converter="{StaticResource BooleanNegationConverter}"/>
                        <Binding Path="DataContext.IsStreaming"
                                 ElementName="Root"
                                 Converter="{StaticResource BooleanNegationConverter}"/>
                    </MultiBinding>
                </views:HudOverlayContent.IsVisible>
            </views:HudOverlayContent>
        </Grid>

        <!-- No signal overlay -->
        <Border Grid.Row="0" Focusable="True"
                x:Name="NoSignalOverlay"
                Background="#1A1A1A"
                IsVisible="{Binding ShowNoSignal}"
                PointerPressed="NoSignalOverlay_PointerPressed"
                PointerReleased="NoSignalOverlay_PointerReleased">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No Signal"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Start RTP/Local Mode to display video"
                           FontSize="14"
                           Foreground="#888888"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="#2D2D30" Padding="8,4" Focusable="True" x:Name="StatusBar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"/>

                <Button x:Name="PlayPauseButton"
                        Grid.Column="1"
                        Width="48"
                        Height="48"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Click="PlayPauseButton_Click">

                    <Grid Width="24" Height="24">
                        <svg:Svg x:Name="PlayIcon"
                                 Path="/Assets/icons/play.svg"
                                 Stretch="Uniform"
                                 Width="24"
                                 Height="24"
                                 IsHitTestVisible="False"
                                 IsVisible="False"/>
                        <svg:Svg x:Name="PauseIcon"
                                 Path="/Assets/icons/pause.svg"
                                 Stretch="Uniform"
                                 Width="24"
                                 Height="24"
                                 IsHitTestVisible="False"/>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                <TextBlock Grid.Column="2"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           Margin="10,0">
                    <Run Text="FPS: "/>
                    <Run Text="{Binding FrameRate, StringFormat={}{0:F1}}"/>
                </TextBlock>

                <CheckBox Content="Local Mode"
                            Margin="0,0,15,0"
                            IsChecked="{Binding UseD3DHost}"
                            ToolTip.Tip="Render HLAE shared texture"
                            Focusable="False"/>

                <TextBlock Text="RTP Stream:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
                <Button Content="Start"
                        Click="StartButton_Click"
                        IsEnabled="{Binding CanStart}"
                        Padding="10,5"/>
                <Button Content="Stop"
                        Click="StopButton_Click"
                        IsEnabled="{Binding CanStop}"
                        Padding="10,5"/>
                <Button Content="Refresh Binds"
                        Click="RefreshBindsButton_Click"
                        Padding="10,5"
                        ToolTip.Tip="Refresh spectator bindings (1-5: CT, 6-0: T)"/>

                <Border Width="24"
                        Height="24"
                        Grid.Column="0"
                        Background="White"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="12"
                        ToolTip.Tip="Controls:&#10;Hold RMB = Activate (inherited init)&#10;Hold CapsLock + RMB = Activate (static init)&#10;WASD = Move Camera&#10;Space/Ctrl = Move Up/Down&#10;Shift = Sprint&#10;Scroll = FOV&#10;Alt+Scroll or Mouse4/5 = Adjust Speed&#10;V = Lock on Player&#10;C or Mouse3 = Hold Input State&#10;B = Handoff from 3D Viewport&#10;G = Enable walkmode&#10;H = Enable handheld"
                        ToolTip.Placement="Pointer">

                    <TextBlock Text="i"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#333"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
