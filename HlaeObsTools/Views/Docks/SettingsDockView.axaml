<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HlaeObsTools.ViewModels.Docks"
             xmlns:rootvm="using:HlaeObsTools.ViewModels"
             xmlns:conv="using:HlaeObsTools.Converters"
             xmlns:hk="using:HlaeObsTools.ViewModels.Hotkeys"
             xmlns:hotkeys="using:HlaeObsTools.Services.Hotkeys"
             xmlns:docks="using:HlaeObsTools.Views.Docks"
             x:Class="HlaeObsTools.Views.Docks.SettingsDockView"
             x:Name="Root"
             x:DataType="vm:SettingsDockViewModel">
    <UserControl.Resources>
        <conv:NullableDoubleTextConverter x:Key="NullableDouble" />
    </UserControl.Resources>
    <Grid>
        <Border Background="#1E1E1E" Padding="10" Focusable="True"
                IsVisible="{Binding !IsEditingAttachPresetAnimation}">
            <TabControl>

            <TabItem Header="General">
                    <ScrollViewer>
                        <StackPanel Margin="10" Spacing="8">
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0" VerticalAlignment="Center">
                                <ToggleSwitch IsChecked="{Binding IsDrawHudEnabled, Mode=TwoWay}" Content="Hide HUD" Foreground="#E6E6E6" hotkeys:HotkeyTarget.Path="IsDrawHudEnabled" Margin="0,0,10,0" />
                                <ToggleSwitch IsChecked="{Binding IsOnlyDeathnotesEnabled, Mode=TwoWay}" Content="Only Deathnotices" hotkeys:HotkeyTarget.Path="IsOnlyDeathnotesEnabled" Foreground="#E6E6E6" />
                                <StackPanel Orientation="Vertical" Spacing="2" Margin="6,0,0,0">
                                    <TextBlock Text="Force Deathnotices" Foreground="#E6E6E6" />
                                    <Button Command="{Binding CycleForceDeathnoticesCommand}" Content="{Binding ForceDeathnoticesLabel}" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0" VerticalAlignment="Center">
                                <ToggleSwitch IsChecked="{Binding IsXrayEnabled, Mode=TwoWay}" Content="Show Xray" Foreground="#E6E6E6" hotkeys:HotkeyTarget.Path="IsXrayEnabled" Margin="0,0,10,0" />
                                <ToggleSwitch IsChecked="{Binding UseAltPlayerBinds, Mode=TwoWay}" Content="Use alt player binds" hotkeys:HotkeyTarget.Path="UseAltPlayerBinds" Foreground="#E6E6E6" />
                            </WrapPanel>
                            <ToggleSwitch IsChecked="{Binding DisableFocusInputGate, Mode=TwoWay}" Content="Disable Focus Input-Gate" hotkeys:HotkeyTarget.Path="DisableFocusInputGate" Foreground="#E6E6E6" />
                            <Button Content="DemoUI" Command="{Binding ToggleDemouiCommand}" />
                            <Separator Margin="0,10,0,6" />
                            <TextBlock Text="Network Endpoints" Foreground="#CCCCCC" FontWeight="SemiBold" />
                            <TextBlock Text="HLAE/GFXP Host" Foreground="#AAAAAA" />
                            <TextBox MinWidth="80" MaxWidth="320" HorizontalAlignment="Left" Text="{Binding WebSocketHost, Mode=TwoWay}" />
                            <TextBlock Text="Ports" Foreground="#AAAAAA" Margin="0,4,0,0" />
                            <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="WS" Foreground="#AAAAAA" />
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                        <TextBox MinWidth="60" MaxWidth="90" Text="{Binding WebSocketPort, Mode=TwoWay}" />
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding WebSocketHealthBrush}" ToolTip.Tip="{Binding WebSocketHealthTooltip}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="UDP" Foreground="#AAAAAA" />
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                        <TextBox MinWidth="60" MaxWidth="90" Text="{Binding UdpPort, Mode=TwoWay}" />
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding UdpHealthBrush}" ToolTip.Tip="{Binding UdpHealthTooltip}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="RTP" Foreground="#AAAAAA" />
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                        <TextBox MinWidth="60" MaxWidth="90" Text="{Binding RtpPort, Mode=TwoWay}" />
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding RtpHealthBrush}" ToolTip.Tip="{Binding RtpHealthTooltip}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="GSI" Foreground="#AAAAAA" />
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                        <TextBox MinWidth="60" MaxWidth="90" Text="{Binding GsiPort, Mode=TwoWay}" />
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding GsiHealthBrush}" ToolTip.Tip="{Binding GsiHealthTooltip}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="GFXP" Foreground="#AAAAAA" />
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                        <TextBox MinWidth="60" MaxWidth="90" Text="{Binding GraphicsProducerPort, Mode=TwoWay}" />
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding GraphicsProducerHealthBrush}" ToolTip.Tip="{Binding GraphicsProducerHealthTooltip}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="GSI Relay Endpoints" Foreground="#AAAAAA" Margin="0,8,0,0" />
                            <ListBox ItemsSource="{Binding GsiRelayEndpoints}" MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GsiRelayEndpointViewModel">
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding HealthBrush}" ToolTip.Tip="{Binding HealthTooltip}" VerticalAlignment="Center" />
                                            <TextBox MinWidth="80" MaxWidth="500" Text="{Binding Uri, Mode=TwoWay}" PlaceholderText="http://127.0.0.1:1349/api/gsi" />
                                            <Button Content="Remove" Command="{Binding DataContext.RemoveGsiRelayEndpointCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Add relay endpoint" HorizontalAlignment="Left" Command="{Binding AddGsiRelayEndpointCommand}" />
                            <Button Content="Apply / Reconnect" HorizontalAlignment="Left" Command="{Binding ApplyNetworkSettingsCommand}" Margin="0,6,0,0" />
                            <Separator Margin="0,10,0,6" />
                            <TextBlock Text="vMix" Foreground="#CCCCCC" FontWeight="SemiBold" />
                            <StackPanel Spacing="6" Margin="0,0,0,12">
                                <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12">
                                    <TextBlock VerticalAlignment="Center" Text="Host" Foreground="#AAAAAA" />
                                    <TextBox MaxWidth="120" MinWidth="100" Text="{Binding VmixSettings.Host, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center" Text="Port" Foreground="#AAAAAA" />
                                    <TextBox MaxWidth="80" Text="{Binding VmixSettings.Port, Mode=TwoWay}" />
                                </WrapPanel>
                                <ToggleSwitch IsChecked="{Binding VmixReplaySettings.Enabled, Mode=TwoWay}" Content="Enable local vMix replay markers" hotkeys:HotkeyTarget.Path="VmixReplaySettings.Enabled" Foreground="#E6E6E6" />
                                <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Pre-roll (s)" Foreground="#AAAAAA" />
                                        <TextBox MinWidth="50" MaxWidth="80" Text="{Binding VmixReplaySettings.PreSeconds, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Post-roll (s)" Foreground="#AAAAAA" />
                                        <TextBox MinWidth="50" MaxWidth="80" Text="{Binding VmixReplaySettings.PostSeconds, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" ToolTip.Tip="Time between kills to extend event to cover both">
                                        <TextBlock Text="Extend window (s)" Foreground="#AAAAAA" />
                                        <TextBox MinWidth="50" MaxWidth="80" Text="{Binding VmixReplaySettings.ExtendWindowSeconds, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" ToolTip.Tip="Set to replay inputs fps for accurate event extension">
                                        <TextBlock Text="Replay FPS" Foreground="#AAAAAA" />
                                        <TextBox MinWidth="50" MaxWidth="80" Text="{Binding VmixReplaySettings.FramesPerSecond, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Channel / camera" Foreground="#AAAAAA" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                            <TextBox MinWidth="40" MaxWidth="55" Text="{Binding VmixReplaySettings.Channel, Mode=TwoWay}" />
                                            <TextBox MinWidth="40" MaxWidth="55" Text="{Binding VmixReplaySettings.Camera, Mode=TwoWay}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                            <Separator Margin="0,10,0,6" />
                            <TextBlock Text="HOT Link" Foreground="#CCCCCC" FontWeight="SemiBold" />
                            <StackPanel Spacing="6" Margin="0,0,0,12">
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="Role" Foreground="#AAAAAA" />
                                    <ComboBox ItemsSource="{Binding HotLinkRoleOptions}" SelectedItem="{Binding HotLinkSettings.Role, Mode=TwoWay}" />
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="Publisher port" Foreground="#AAAAAA" />
                                    <TextBox MinWidth="80" Text="{Binding HotLinkSettings.PublisherPort, Mode=TwoWay}" />
                                </WrapPanel>
                                <StackPanel IsVisible="{Binding HotLinkSettings.IsClient}" Spacing="6">
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="Client mode" Foreground="#AAAAAA" />
                                        <ComboBox MinWidth="190" ItemsSource="{Binding HotLinkClientModeOptions}" SelectedItem="{Binding HotLinkSettings.ClientMode, Mode=TwoWay}" />
                                    </WrapPanel>
                                    <WrapPanel IsVisible="{Binding HotLinkSettings.IsDiscoveryHostEnabled}" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                        <Button Content="Refresh hosts" Command="{Binding RefreshHotLinkPublishersCommand}" />
                                        <ComboBox MinWidth="260" ItemsSource="{Binding HotLinkPublishers}" SelectedItem="{Binding SelectedHotLinkPublisher, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </WrapPanel>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <ToggleSwitch IsChecked="{Binding HotLinkSettings.ManualHost, Mode=TwoWay}" Content="Manual Host" Foreground="#E6E6E6" />
                                        <StackPanel IsVisible="{Binding HotLinkSettings.ManualHost}" Orientation="Horizontal" Spacing="8">
                                            <TextBlock VerticalAlignment="Center" Text="Publisher IP" Foreground="#AAAAAA" />
                                            <TextBox MinWidth="80" MaxLines="1" VerticalAlignment="Center" Text="{Binding HotLinkSettings.PublisherIp, Mode=TwoWay}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <Button IsVisible="{Binding HotLinkSettings.IsClientDisconnected}" IsEnabled="{Binding CanConnectHotLinkClient}" Content="Connect" Command="{Binding ConnectHotLinkClientCommand}" />
                                    <Button IsVisible="{Binding HotLinkSettings.ClientConnectionEnabled}" Content="Disconnect" Command="{Binding DisconnectHotLinkClientCommand}" />
                                </StackPanel>
                                <WrapPanel IsVisible="{Binding HotLinkSettings.IsReplayDirectorMode}" Orientation="Horizontal" ItemSpacing="12" LineSpacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Pre-switch (s)" Foreground="#AAAAAA" />
                                        <TextBox MinWidth="50" MaxWidth="80" Text="{Binding HotLinkSettings.PreSwitchSeconds, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Switch lock (s)" Foreground="#AAAAAA" />
                                        <TextBox MinWidth="50" MaxWidth="80" Text="{Binding HotLinkSettings.SwitchLockSeconds, Mode=TwoWay}" />
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel IsVisible="{Binding HotLinkSettings.IsPublisher}" Spacing="6">
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="Delayed channel / camera" Foreground="#AAAAAA" />
                                        <TextBox MaxWidth="55" Text="{Binding HotLinkSettings.DelayedVmixChannel, Mode=TwoWay}" />
                                        <TextBox MaxWidth="55" Text="{Binding HotLinkSettings.DelayedVmixCamera, Mode=TwoWay}" />
                                    </WrapPanel>
                                    <ToggleSwitch IsChecked="{Binding HotLinkSettings.AcceptReplayMarkRequests, Mode=TwoWay}" Content="Accept delayed vMix replay marks" Foreground="#E6E6E6" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding HotLinkSettings.IsReplayDirectorMode}" Spacing="6">
                                    <CheckBox IsChecked="{Binding HotLinkSettings.OnlyFollowMissedKills, Mode=TwoWay}" Content="Only follow missed kills" Foreground="#E6E6E6" />
                                </StackPanel>
                                <WrapPanel IsVisible="{Binding HotLinkSettings.IsCueMode}" ItemSpacing="8" LineSpacing="8">
                                    <ToggleSwitch IsChecked="{Binding HotLinkSettings.CueTimelineEnabled, Mode=TwoWay}" Content="Show cue timeline" Foreground="#E6E6E6" />
                                    <ToggleSwitch IsChecked="{Binding HotLinkSettings.CueRadarEnabled, Mode=TwoWay}" Content="Show radar cues" Foreground="#E6E6E6" />
                                    <ToggleSwitch IsChecked="{Binding HotLinkSettings.CueViewportEnabled, Mode=TwoWay}" Content="Show 3D viewport cues" Foreground="#E6E6E6" />
                                    <CheckBox IsChecked="{Binding HotLinkSettings.CueTimelineAutoRange, Mode=TwoWay}" Content="Automatic timeline range" Foreground="#E6E6E6" />
                                    <WrapPanel IsVisible="{Binding !HotLinkSettings.CueTimelineAutoRange}" Orientation="Horizontal" ItemSpacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="Upcoming range (s)" Foreground="#AAAAAA" />
                                        <TextBox MinWidth="55" MaxWidth="80" Text="{Binding HotLinkSettings.CueTimelineFixedUpcomingSeconds, Mode=TwoWay}" />
                                    </WrapPanel>
                                </WrapPanel>
                                <StackPanel IsVisible="{Binding HotLinkSettings.IsPublisher}" Spacing="6">
                                    <TextBlock Text="{Binding HotLinkSettings.Status}" Foreground="#AAAAAA" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding HotLinkSettings.LastKill}" Foreground="#AAAAAA" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding HotLinkSettings.LastVmixMark}" Foreground="#AAAAAA" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding HotLinkSettings.IsClient}" Spacing="6">
                                    <TextBlock Text="{Binding HotLinkSettings.Status}" Foreground="#AAAAAA" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding HotLinkSettings.LocalGameTime}" Foreground="#AAAAAA" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding HotLinkSettings.LastKill}" Foreground="#AAAAAA" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding HotLinkSettings.ScheduledTarget}"
                                               IsVisible="{Binding HotLinkSettings.IsReplayDirectorMode}"
                                               Foreground="#AAAAAA" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding HotLinkSettings.LastSwitch}"
                                               IsVisible="{Binding HotLinkSettings.IsReplayDirectorMode}"
                                               Foreground="#AAAAAA" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding HotLinkSettings.LastVmixMark}"
                                               IsVisible="{Binding HotLinkSettings.IsReplayDirectorMode}"
                                               Foreground="#AAAAAA" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            <TabItem Header="Create">
                    <ScrollViewer>
                    <StackPanel Margin="10" Spacing="8">

                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="Campath editor"
                                       Foreground="#CCCCCC"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Default campath interp"
                                       Foreground="#AAAAAA"/>
                            <ComboBox Width="150"
                                        ItemsSource="{Binding DefaultCampathInterpOptions}"
                                        SelectedItem="{Binding DefaultCampathInterp, Mode=TwoWay}"
                                        Margin="0,0,10,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="rootvm:CampathEditorModeOption">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0">
                                <ToggleSwitch IsChecked="{Binding CampathHold, Mode=TwoWay}"
                                              Content="Hold"
                                    hotkeys:HotkeyTarget.Path="CampathHold"
                                              Foreground="#E6E6E6"/>
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.ViewportCampathOverlayEnabled, Mode=TwoWay}"
                                              Content="Draw Path"
                                              Foreground="#E6E6E6"
                                    hotkeys:HotkeyTarget.Path="Viewport3DSettings.ViewportCampathOverlayEnabled"
                                              Margin="0,0,10,0"/>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.ViewportCampathGizmoEnabled, Mode=TwoWay}"
                                              Content="Show Gizmo"
                                              Foreground="#E6E6E6"
                                    hotkeys:HotkeyTarget.Path="Viewport3DSettings.ViewportCampathGizmoEnabled"
                                              Margin="0,0,10,0"/>
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.CampathGizmoLocalSpace, Mode=TwoWay}"
                                              Content="Gizmo Local"
                                              Foreground="#E6E6E6"
                                    hotkeys:HotkeyTarget.Path="Viewport3DSettings.CampathGizmoLocalSpace"
                                              Margin="0,0,10,0"/>
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.ViewportCampathSyncEnabled, Mode=TwoWay}"
                                              Content="HLAE-Sync"
                                              Foreground="#E6E6E6"
                                    hotkeys:HotkeyTarget.Path="Viewport3DSettings.ViewportCampathSyncEnabled"
                                              Margin="0,0,10,0"/>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center" IsVisible="{Binding Viewport3DSettings.ViewportCampathSyncEnabled, Mode=TwoWay}">
                                <TextBlock Text="Timeskip-mode" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Viewport3DSettings.HlaeSyncTimeSkipModes}"
                                          SelectedItem="{Binding Viewport3DSettings.HlaeSyncTimeSkipMode, Mode=TwoWay}"/>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="Time Offset" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                <TextBox MinWidth="80" MaxWidth="90"
                                         Text="{Binding CampathEditor.TimeOffset, Mode=TwoWay, StringFormat={}{0:F2}}"/>
                                <Button Content="Get Current"
                                        Command="{Binding GetCurrentTimeOffsetCommand}"
                                        Margin="6,0,0,0"/>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0">
                                <Button Content="Load"
                                        Command="{Binding LoadViewportCampathCommand}"/>
                                <Button Content="Save"
                                        Command="{Binding SaveViewportCampathCommand}"/>
                                <Button Content="Clear"
                                        Command="{Binding CampathEditor.ClearCommand}"/>
                            </WrapPanel>
                        </StackPanel>

                        <ToggleSwitch IsChecked="{Binding ShowHlaeCampathControls, Mode=TwoWay}"
                                      Content="Show HLAE controls"
                                      Foreground="#E6E6E6"
                                      Margin="0,8,0,0"/>

                        <Border IsVisible="{Binding ShowHlaeCampathControls}"
                                Background="#191C22"
                                BorderBrush="#343842"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                            <StackPanel Spacing="8">
                                <TextBlock Text="CS2 / HLAE campath controls"
                                           Foreground="#CCCCCC"
                                           FontWeight="SemiBold"/>
                                <WrapPanel Orientation="Horizontal"
                                            ItemSpacing="6" LineSpacing="6"
                                            VerticalAlignment="Center">
                                    <ToggleSwitch IsChecked="{Binding IsCameraPathPreviewEnabled, Mode=TwoWay}"
                                                  Content="Draw path"
                                                  Foreground="#E6E6E6"
                                                  HorizontalAlignment="Left"
                                                  hotkeys:HotkeyTarget.Path="IsCameraPathPreviewEnabled"
                                                  Margin="0,0,10,0"/>
                                    <ToggleSwitch IsChecked="{Binding IsCampathEnabled, Mode=TwoWay}"
                                                  Content="Enable campath"
                                                  hotkeys:HotkeyTarget.Path="IsCampathEnabled"
                                                  Foreground="#E6E6E6"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal"
                                            ItemSpacing="6" LineSpacing="6"
                                            VerticalAlignment="Center">
                                    <Button Content="Add point"
                                            Command="{Binding AddPointCommand}"/>
                                    <Button Content="Clear campath"
                                            Command="{Binding ClearCampathCommand}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal"
                                            ItemSpacing="6" LineSpacing="6"
                                            VerticalAlignment="Center">
                                    <Button Content="{Binding InterpLabel}"
                                            Command="{Binding ToggleInterpModeCommand}"/>
                                    <Button Content="Load campath"
                                            Command="{Binding LoadCampathCommand}"/>
                                    <Button Content="Save campath"
                                            Command="{Binding SaveCampathCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Radar">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="10">
                        <TextBlock Text="Style"
                                Foreground="#CCCCCC"
                                FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding RadarSettings.RadarStyles}"
                                  SelectedItem="{Binding RadarSettings.RadarStyle, Mode=TwoWay}"/>
                        <TextBlock Text="Radar scale"
                                Foreground="#CCCCCC"
                                FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10"
                              Width="{Binding $parent[StackPanel].Bounds.Width}"
                              MaxWidth="360"
                              HorizontalAlignment="Left">
                            <Slider Minimum="0.5"
                                    Maximum="2.0"
                                    SmallChange="0.05"
                                    LargeChange="0.25"
                                    HorizontalAlignment="Stretch"
                                    Value="{Binding RadarSettings.RadarScale, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1"
                                    Text="{Binding RadarSettings.RadarScale, StringFormat={}{0:F2}}"
                                    Width="50"
                                    Foreground="#E6E6E6"/>
                        </Grid>
                        <TextBlock Text="Marker size"
                                Foreground="#CCCCCC"
                                FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10"
                              Width="{Binding $parent[StackPanel].Bounds.Width}"
                              MaxWidth="360"
                              HorizontalAlignment="Left">
                            <Slider Minimum="0.5"
                                    Maximum="2.5"
                                    SmallChange="0.05"
                                    LargeChange="0.25"
                                    HorizontalAlignment="Stretch"
                                    Value="{Binding RadarSettings.MarkerScale, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1"
                                    Text="{Binding RadarSettings.MarkerScale, StringFormat={}{0:F2}}"
                                    Width="50"
                                    Foreground="#E6E6E6"/>
                        </Grid>
                        <TextBlock Text="Height scale strength"
                                Foreground="#CCCCCC"
                                FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10"
                              Width="{Binding $parent[StackPanel].Bounds.Width}"
                              MaxWidth="360"
                              HorizontalAlignment="Left">
                            <Slider Minimum="0"
                                    Maximum="2"
                                    SmallChange="0.05"
                                    LargeChange="0.25"
                                    HorizontalAlignment="Stretch"
                                    Value="{Binding RadarSettings.HeightScaleMultiplier, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1"
                                    Text="{Binding RadarSettings.HeightScaleMultiplier, StringFormat={}{0:F2}}"
                                    Width="50"
                                    Foreground="#E6E6E6"/>
                        </Grid>
                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                            <ToggleSwitch IsChecked="{Binding RadarSettings.DisplayNumbersTopmost, Mode=TwoWay}"
                                        Content="Observer-Slot on top"
                                hotkeys:HotkeyTarget.Path="RadarSettings.DisplayNumbersTopmost"
                                        Foreground="#E6E6E6"/>
                            <ToggleSwitch IsChecked="{Binding RadarSettings.ShowPlayerNames, Mode=TwoWay}"
                                        Content="Show player names"
                                hotkeys:HotkeyTarget.Path="RadarSettings.ShowPlayerNames"
                                        Foreground="#E6E6E6"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="HUD">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="10">
                        <TextBlock Text="Video HUD Overlay"
                                Foreground="#CCCCCC"
                                FontWeight="SemiBold"/>
                        <ToggleSwitch IsChecked="{Binding HudSettings.IsHudEnabled, Mode=TwoWay}"
                                    Content="Enable HUD"
                            hotkeys:HotkeyTarget.Path="HudSettings.IsHudEnabled"
                                    Foreground="#E6E6E6"/>
                        <TextBlock Text="HUD size"
                                Foreground="#CCCCCC"
                                FontWeight="SemiBold"
                                Margin="0,8,0,0"/>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10"
                              Width="{Binding $parent[StackPanel].Bounds.Width}"
                              MaxWidth="360"
                              HorizontalAlignment="Left">
                            <Slider Minimum="0.25"
                                    Maximum="3.0"
                                    SmallChange="0.05"
                                    LargeChange="0.25"
                                    HorizontalAlignment="Stretch"
                                    Value="{Binding HudSettings.HudSize, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1"
                                    Text="{Binding HudSettings.HudSize, StringFormat={}{0:F2}}"
                                    Width="50"
                                    Foreground="#E6E6E6"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <ToggleSwitch IsChecked="{Binding HudSettings.ShowKillfeed, Mode=TwoWay}"
                                    Content="Show killfeed"
                            hotkeys:HotkeyTarget.Path="HudSettings.ShowKillfeed"
                                    Foreground="#E6E6E6"/>
                        <ToggleSwitch IsChecked="{Binding HudSettings.ShowKillfeedAttackerSlot, Mode=TwoWay}"
                                    Content="Show killfeed attacker bind"
                            hotkeys:HotkeyTarget.Path="HudSettings.ShowKillfeedAttackerSlot"
                                    Foreground="#E6E6E6"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="3D">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="10">
                        <TextBlock Text="Counter-Strike 2 folder"
                                Foreground="#CCCCCC"
                                FontWeight="SemiBold"/>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                            <TextBox MinWidth="80" MaxWidth="320"
                                    Text="{Binding Viewport3DSettings.Cs2GameFolder, Mode=TwoWay}"
                                    PlaceholderText="C:\Program Files (x86)\Steam\steamapps\common\Counter-Strike Global Offensive"/>
                            <Button Content="Browse"
                                    Command="{Binding BrowseMapObjCommand}"/>
                            <Button Content="Clear"
                                    Command="{Binding ClearMapObjCommand}"/>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                            <ComboBox MinWidth="60"
                                      ItemsSource="{Binding Viewport3DSettings.AvailableMaps}"
                                      SelectedItem="{Binding Viewport3DSettings.SelectedMap, Mode=TwoWay}"
                                      PlaceholderText="Select map">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox IsChecked="{Binding Viewport3DSettings.ActiveDutyMapsOnly, Mode=TwoWay}"
                                      Content="Active Duty Maps"
                                      Foreground="#E6E6E6"
                                      VerticalAlignment="Center"
                                      hotkeys:HotkeyTarget.Path="Viewport3DSettings.ActiveDutyMapsOnly"/>
                            <CheckBox IsChecked="{Binding Viewport3DSettings.ShowWorkshopMaps, Mode=TwoWay}"
                                      Content="Workshop Maps"
                                      Foreground="#E6E6E6"
                                      VerticalAlignment="Center"
                                      hotkeys:HotkeyTarget.Path="Viewport3DSettings.ShowWorkshopMaps"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Viewport3DSettings.MapObjPath}" TextWrapping="Wrap"
                                Foreground="#888888"
                                FontSize="12"/>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                            <StackPanel>
                                <TextBlock Text="Mouse scale"
                                        Foreground="#CCCCCC"
                                        FontWeight="SemiBold"
                                        Margin="0,10,0,0"/>
                                <TextBox MinWidth="80" MaxWidth="120"
                                        Text="{Binding Viewport3DSettings.ViewportMouseScale, Mode=TwoWay}"
                                        PlaceholderText="1.0"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="FPS cap"
                                        Foreground="#CCCCCC"
                                        FontWeight="SemiBold"
                                        Margin="0,10,0,0"/>
                                <TextBox MinWidth="80" MaxWidth="120"
                                        Text="{Binding Viewport3DSettings.ViewportFpsCap, Mode=TwoWay}"
                                        PlaceholderText="60"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                            <ToggleSwitch IsChecked="{Binding Viewport3DSettings.ShowFps, Mode=TwoWay}"
                                        Content="Show FPS"
                                        Foreground="#E6E6E6"
                                hotkeys:HotkeyTarget.Path="Viewport3DSettings.ShowFps"
                                        Margin="0,6,0,0"/>
                            <ToggleSwitch IsChecked="{Binding Viewport3DSettings.ShowPlayerPins, Mode=TwoWay}"
                                        Content="Show player pins"
                                        Foreground="#E6E6E6"
                                hotkeys:HotkeyTarget.Path="Viewport3DSettings.ShowPlayerPins"
                                        Margin="0,6,0,0"/>
                        </WrapPanel>



                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                            <StackPanel>
                                <TextBlock Text="Pin scale"
                                        Foreground="#CCCCCC"
                                        FontWeight="SemiBold"
                                        Margin="0,10,0,0"/>
                                <TextBox MinWidth="80" MaxWidth="120"
                                        Text="{Binding Viewport3DSettings.PinScale, Mode=TwoWay}"
                                        PlaceholderText="1.0"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Pin Z offset"
                                        Foreground="#CCCCCC"
                                        FontWeight="SemiBold"
                                        Margin="0,10,0,0"/>
                                <TextBox MinWidth="80" MaxWidth="120"
                                        Text="{Binding Viewport3DSettings.PinOffsetZ, Mode=TwoWay}"
                                        PlaceholderText="Z"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel>
                            <TextBlock Text="Camera"
                                    Foreground="#CCCCCC"
                                    FontWeight="SemiBold"
                                    Margin="0,10,0,0"/>
                            <Button Content="Reset target orbit"
                                    Command="{Binding ResetTargetOrbitCommand}"
                                    HorizontalAlignment="Left"
                                    ToolTip.Tip="Return the VRF viewport to the saved normal orbit"/>

                            <TextBlock Text="Rendering"
                                    Foreground="#CCCCCC"
                                    FontWeight="Bold"
                                    FontSize="18"
                                    Margin="0,10,0,10"/>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.PostprocessEnabled, Mode=TwoWay}"
                                            Content="Postprocess"
                                    hotkeys:HotkeyTarget.Path="Viewport3DSettings.PostprocessEnabled"
                                            Foreground="#E6E6E6"/>
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.ColorCorrectionEnabled, Mode=TwoWay}"
                                            Content="Color correction"
                                    hotkeys:HotkeyTarget.Path="Viewport3DSettings.ColorCorrectionEnabled"
                                            Foreground="#E6E6E6"/>
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.DynamicShadowsEnabled, Mode=TwoWay}"
                                            Content="Dynamic shadows"
                                    hotkeys:HotkeyTarget.Path="Viewport3DSettings.DynamicShadowsEnabled"
                                            Foreground="#E6E6E6"/>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.WireframeEnabled, Mode=TwoWay}"
                                            Content="Wireframe"
                                    hotkeys:HotkeyTarget.Path="Viewport3DSettings.WireframeEnabled"
                                            Foreground="#E6E6E6"/>
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.SkipWaterEnabled, Mode=TwoWay}"
                                            Content="Skip water"
                                    hotkeys:HotkeyTarget.Path="Viewport3DSettings.SkipWaterEnabled"
                                            Foreground="#E6E6E6"/>
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.SkipTranslucentEnabled, Mode=TwoWay}"
                                            Content="Skip translucents"
                                    hotkeys:HotkeyTarget.Path="Viewport3DSettings.SkipTranslucentEnabled"
                                            Foreground="#E6E6E6"/>
                            </WrapPanel>

                            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12" Margin="0,6,0,0">
                                <StackPanel Orientation="Vertical" Spacing="4">
                                    <TextBlock Text="Render mode"
                                            Foreground="#CCCCCC"
                                            FontWeight="SemiBold"/>
                                    <ComboBox Width="180"
                                            ItemsSource="{Binding Viewport3DSettings.RenderModeOptions}"
                                            SelectedItem="{Binding Viewport3DSettings.RenderMode, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Spacing="4">
                                    <TextBlock Text="Shadow resolution"
                                            Foreground="#CCCCCC"
                                            FontWeight="SemiBold"/>
                                    <ComboBox Width="120"
                                            ItemsSource="{Binding Viewport3DSettings.ShadowTextureSizeOptions}"
                                            SelectedItem="{Binding Viewport3DSettings.ShadowTextureSize, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Spacing="4">
                                    <TextBlock Text="Max texture size"
                                            Foreground="#CCCCCC"
                                            FontWeight="SemiBold"/>
                                    <ComboBox Width="120"
                                            ItemsSource="{Binding Viewport3DSettings.MaxTextureSizeOptions}"
                                            SelectedItem="{Binding Viewport3DSettings.MaxTextureSize, Mode=TwoWay}"/>
                                </StackPanel>
                            </WrapPanel>
                            <Separator Margin="0,10,0,6" />
                            <TextBlock Text="LiveLink"
                                    Foreground="#CCCCCC"
                                    FontWeight="Bold"
                                    FontSize="18"
                                    Margin="0,5,0,10"/>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12">
                                <ToggleSwitch IsChecked="{Binding Viewport3DSettings.LiveLinkEnabled, Mode=TwoWay}"
                                            Content="Receive CS2 entities"
                                            Foreground="#E6E6E6"/>
                                <StackPanel Orientation="Vertical" Spacing="4">
                                    <TextBlock Text="UDP port"
                                            Foreground="#CCCCCC"
                                            FontWeight="SemiBold"/>
                                    <TextBox MinWidth="80" MaxWidth="100"
                                            Text="{Binding Viewport3DSettings.LiveLinkPort, Mode=TwoWay}"
                                            PlaceholderText="31237"/>
                                </StackPanel>
                            </WrapPanel>
                            <ToggleSwitch IsChecked="{Binding Viewport3DSettings.LiveLinkItemIconsEnabled, Mode=TwoWay}"
                                        Content="Show viewport icons"
                                        Foreground="#E6E6E6"
                                hotkeys:HotkeyTarget.Path="Viewport3DSettings.LiveLinkItemIconsEnabled"
                                        Margin="0,6,0,0"/>
                            <WrapPanel Orientation="Horizontal"
                                        ItemSpacing="10" LineSpacing="10"
                                        IsEnabled="{Binding Viewport3DSettings.LiveLinkItemIconsEnabled}">
                                <TextBlock Text="Viewport icons:"
                                        Foreground="#CCCCCC"
                                        VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding Viewport3DSettings.LiveLinkWeaponIconsEnabled, Mode=TwoWay}"
                                        Content="Weapons"
                                        Foreground="#E6E6E6"
                                        hotkeys:HotkeyTarget.Path="Viewport3DSettings.LiveLinkWeaponIconsEnabled"/>
                                <CheckBox IsChecked="{Binding Viewport3DSettings.LiveLinkGrenadeIconsEnabled, Mode=TwoWay}"
                                        Content="Grenades"
                                        Foreground="#E6E6E6"
                                        hotkeys:HotkeyTarget.Path="Viewport3DSettings.LiveLinkGrenadeIconsEnabled"/>
                                <CheckBox IsChecked="{Binding Viewport3DSettings.LiveLinkProjectileIconsEnabled, Mode=TwoWay}"
                                        Content="Projectiles"
                                        Foreground="#E6E6E6"
                                        hotkeys:HotkeyTarget.Path="Viewport3DSettings.LiveLinkProjectileIconsEnabled"/>
                                <CheckBox IsChecked="{Binding Viewport3DSettings.LiveLinkObjectiveIconsEnabled, Mode=TwoWay}"
                                        Content="Defusers &amp; C4"
                                        Foreground="#E6E6E6"
                                        hotkeys:HotkeyTarget.Path="Viewport3DSettings.LiveLinkObjectiveIconsEnabled"/>
                                <CheckBox IsChecked="{Binding Viewport3DSettings.LiveLinkDeadPlayerIconsEnabled, Mode=TwoWay}"
                                        Content="Dead players"
                                        Foreground="#E6E6E6"
                                        hotkeys:HotkeyTarget.Path="Viewport3DSettings.LiveLinkDeadPlayerIconsEnabled"/>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12">
                                <Button Content="Start LiveLink Stream"
                                        Command="{Binding StartLiveLinkStreamCommand}"/>
                                <Button Content="Stop LiveLink Stream"
                                        Command="{Binding StopLiveLinkStreamCommand}"/>
                                <StackPanel Orientation="Vertical" Spacing="4">
                                    <TextBlock Text="FPS"
                                            Foreground="#CCCCCC"
                                            FontWeight="SemiBold"/>
                                    <TextBox MinWidth="60" MaxWidth="80"
                                            Text="{Binding Viewport3DSettings.LiveLinkFps, Mode=TwoWay}"
                                            PlaceholderText="10"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Attach">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="12">
                        <TextBlock Text="Attach Presets"
                                   Foreground="#CCCCCC"
                                   FontWeight="SemiBold"/>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                            <TextBlock Text="Page" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            <ComboBox Width="180"
                                      ItemsSource="{Binding AttachPresetPageOptions}"
                                      SelectedIndex="{Binding ActiveAttachPresetPage, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Name" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            <TextBox MinWidth="80" MaxWidth="220"
                                     PlaceholderText="Page name"
                                     Text="{Binding CurrentAttachPresetPageName, Mode=TwoWay}"/>
                        </WrapPanel>
                        <TextBlock Text="The player-card radial now opens attach pages first, then the presets on the selected page."
                                   Foreground="#888888"
                                   FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding AttachPresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Title}" Foreground="#E6E6E6" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding AnimationSummary}" Foreground="#888888" FontSize="12"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Animation"
                                                        Click="OpenAnimationEditor_Click"
                                                        HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="Execute preset on slot"
                                                       Foreground="#AAAAAA"
                                                       FontSize="12"/>
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                                                        <Button Content="1"
                                                                Command="{Binding DataContext.ExecuteAttachPresetSlot1Command, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                hotkeys:HotkeyTarget.AttachAction="execute"
                                                                hotkeys:HotkeyTarget.AttachPresetIndex="{Binding PresetIndex}"
                                                                hotkeys:HotkeyTarget.AttachPresetPage="{Binding DataContext.ActiveAttachPresetPage, ElementName=Root}"
                                                                hotkeys:HotkeyTarget.AttachSlot="0"/>
                                                        <Button Content="2"
                                                                Command="{Binding DataContext.ExecuteAttachPresetSlot2Command, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                hotkeys:HotkeyTarget.AttachAction="execute"
                                                                hotkeys:HotkeyTarget.AttachPresetIndex="{Binding PresetIndex}"
                                                                hotkeys:HotkeyTarget.AttachPresetPage="{Binding DataContext.ActiveAttachPresetPage, ElementName=Root}"
                                                                hotkeys:HotkeyTarget.AttachSlot="1"/>
                                                        <Button Content="3"
                                                                Command="{Binding DataContext.ExecuteAttachPresetSlot3Command, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                hotkeys:HotkeyTarget.AttachAction="execute"
                                                                hotkeys:HotkeyTarget.AttachPresetIndex="{Binding PresetIndex}"
                                                                hotkeys:HotkeyTarget.AttachPresetPage="{Binding DataContext.ActiveAttachPresetPage, ElementName=Root}"
                                                                hotkeys:HotkeyTarget.AttachSlot="2"/>
                                                        <Button Content="4"
                                                                Command="{Binding DataContext.ExecuteAttachPresetSlot4Command, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                hotkeys:HotkeyTarget.AttachAction="execute"
                                                                hotkeys:HotkeyTarget.AttachPresetIndex="{Binding PresetIndex}"
                                                                hotkeys:HotkeyTarget.AttachPresetPage="{Binding DataContext.ActiveAttachPresetPage, ElementName=Root}"
                                                                hotkeys:HotkeyTarget.AttachSlot="3"/>
                                                        <Button Content="5"
                                                                Command="{Binding DataContext.ExecuteAttachPresetSlot5Command, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                hotkeys:HotkeyTarget.AttachAction="execute"
                                                                hotkeys:HotkeyTarget.AttachPresetIndex="{Binding PresetIndex}"
                                                                hotkeys:HotkeyTarget.AttachPresetPage="{Binding DataContext.ActiveAttachPresetPage, ElementName=Root}"
                                                                hotkeys:HotkeyTarget.AttachSlot="4"/>
                                                        <Button Content="6"
                                                                Command="{Binding DataContext.ExecuteAttachPresetSlot6Command, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                hotkeys:HotkeyTarget.AttachAction="execute"
                                                                hotkeys:HotkeyTarget.AttachPresetIndex="{Binding PresetIndex}"
                                                                hotkeys:HotkeyTarget.AttachPresetPage="{Binding DataContext.ActiveAttachPresetPage, ElementName=Root}"
                                                                hotkeys:HotkeyTarget.AttachSlot="5"/>
                                                        <Button Content="7"
                                                                Command="{Binding DataContext.ExecuteAttachPresetSlot7Command, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                hotkeys:HotkeyTarget.AttachAction="execute"
                                                                hotkeys:HotkeyTarget.AttachPresetIndex="{Binding PresetIndex}"
                                                                hotkeys:HotkeyTarget.AttachPresetPage="{Binding DataContext.ActiveAttachPresetPage, ElementName=Root}"
                                                                hotkeys:HotkeyTarget.AttachSlot="6"/>
                                                        <Button Content="8"
                                                                Command="{Binding DataContext.ExecuteAttachPresetSlot8Command, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                hotkeys:HotkeyTarget.AttachAction="execute"
                                                                hotkeys:HotkeyTarget.AttachPresetIndex="{Binding PresetIndex}"
                                                                hotkeys:HotkeyTarget.AttachPresetPage="{Binding DataContext.ActiveAttachPresetPage, ElementName=Root}"
                                                                hotkeys:HotkeyTarget.AttachSlot="7"/>
                                                        <Button Content="9"
                                                                Command="{Binding DataContext.ExecuteAttachPresetSlot9Command, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                hotkeys:HotkeyTarget.AttachAction="execute"
                                                                hotkeys:HotkeyTarget.AttachPresetIndex="{Binding PresetIndex}"
                                                                hotkeys:HotkeyTarget.AttachPresetPage="{Binding DataContext.ActiveAttachPresetPage, ElementName=Root}"
                                                                hotkeys:HotkeyTarget.AttachSlot="8"/>
                                                        <Button Content="0"
                                                                Command="{Binding DataContext.ExecuteAttachPresetSlot0Command, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                hotkeys:HotkeyTarget.AttachAction="execute"
                                                                hotkeys:HotkeyTarget.AttachPresetIndex="{Binding PresetIndex}"
                                                                hotkeys:HotkeyTarget.AttachPresetPage="{Binding DataContext.ActiveAttachPresetPage, ElementName=Root}"
                                                                hotkeys:HotkeyTarget.AttachSlot="9"/>
                                            </WrapPanel>
                                            <TextBlock Text="Preset Name" Foreground="#AAAAAA" FontSize="12"/>
                                            <TextBox MinWidth="80" MaxWidth="300"
                                                    PlaceholderText="Preset name"
                                                    Text="{Binding Name, Mode=TwoWay}"
                                                    HorizontalAlignment="Left" />
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                <StackPanel>
                                                    <TextBlock Text="Attachment" Foreground="#AAAAAA" FontSize="12"/>
                                                    <ComboBox ItemsSource="{Binding AttachmentOptions}"
                                                            SelectedItem="{Binding AttachmentName, Mode=TwoWay}"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Bone" Foreground="#AAAAAA" FontSize="12"/>
                                                    <ComboBox ItemsSource="{Binding BoneOptions}"
                                                            SelectedItem="{Binding BoneSelection, Mode=TwoWay}"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </WrapPanel>
                                            <TextBlock Text="Position Offset" Foreground="#AAAAAA" FontSize="12"/>
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                <TextBox MinWidth="40" MaxWidth="80" PlaceholderText="X" Text="{Binding OffsetPosX, Mode=TwoWay, Converter={StaticResource NullableDouble}}" />
                                                <TextBox MinWidth="40" MaxWidth="80" PlaceholderText="Y" Text="{Binding OffsetPosY, Mode=TwoWay, Converter={StaticResource NullableDouble}}" />
                                                <TextBox MinWidth="40" MaxWidth="80" PlaceholderText="Z" Text="{Binding OffsetPosZ, Mode=TwoWay, Converter={StaticResource NullableDouble}}" />
                                            </WrapPanel>

                                            <TextBlock Text="Rotation Offset (deg)" Foreground="#AAAAAA" FontSize="12"/>
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                <TextBox MinWidth="40" MaxWidth="80" PlaceholderText="Pitch" Text="{Binding OffsetPitch, Mode=TwoWay, Converter={StaticResource NullableDouble}}" />
                                                <TextBox MinWidth="40" MaxWidth="80" PlaceholderText="Yaw" Text="{Binding OffsetYaw, Mode=TwoWay, Converter={StaticResource NullableDouble}}" />
                                                <TextBox MinWidth="40" MaxWidth="80" PlaceholderText="Roll" Text="{Binding OffsetRoll, Mode=TwoWay, Converter={StaticResource NullableDouble}}" />
                                            </WrapPanel>

                                            <TextBlock Text="Rotation Basis" Foreground="#AAAAAA" FontSize="12"/>
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                <ComboBox Width="80"
                                                    ItemsSource="{Binding RotationBasisOptions}"
                                                    SelectedItem="{Binding RotationBasisPitch, Mode=TwoWay}"/>
                                                <ComboBox Width="80"
                                                    ItemsSource="{Binding RotationBasisOptions}"
                                                    SelectedItem="{Binding RotationBasisYaw, Mode=TwoWay}"/>
                                                <ComboBox Width="80"
                                                    ItemsSource="{Binding RotationBasisOptions}"
                                                    SelectedItem="{Binding RotationBasisRoll, Mode=TwoWay}"/>
                                            </WrapPanel>

                                            <TextBlock Text="Rotation Reference" Foreground="#AAAAAA" FontSize="12"/>
                                            <ComboBox Width="200"
                                                      ItemsSource="{Binding RotationReferenceOptions}"
                                                      SelectedItem="{Binding RotationReference, Mode=TwoWay}"/>

                                            <TextBlock Text="Rotation Axis Lock (world)" Foreground="#AAAAAA" FontSize="12"/>
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12">
                                                <ToggleSwitch Content="Pitch"
                                                              IsChecked="{Binding RotationLockPitch, Mode=TwoWay}"
                                                    hotkeys:HotkeyTarget.Path="RotationLockPitch"
                                                              Foreground="#E6E6E6"/>
                                                <ToggleSwitch Content="Yaw"
                                                              IsChecked="{Binding RotationLockYaw, Mode=TwoWay}"
                                                    hotkeys:HotkeyTarget.Path="RotationLockYaw"
                                                              Foreground="#E6E6E6"/>
                                                <ToggleSwitch Content="Roll"
                                                              IsChecked="{Binding RotationLockRoll, Mode=TwoWay}"
                                                    hotkeys:HotkeyTarget.Path="RotationLockRoll"
                                                              Foreground="#E6E6E6"/>
                                            </WrapPanel>

                                            <TextBlock Text="FOV" Foreground="#AAAAAA" FontSize="12"/>
                                            <TextBox MinWidth="80" MaxWidth="100" PlaceholderText="90" HorizontalAlignment="Left" Text="{Binding Fov, Mode=TwoWay, Converter={StaticResource NullableDouble}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hotkeys">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="10">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Category" VerticalAlignment="Center"
                                        Foreground="#CCCCCC"
                                        FontWeight="SemiBold"/>
                                <ComboBox Width="120" VerticalAlignment="Center" Margin="0,0,10,0"
                                            ItemsSource="{Binding HotkeyCategoryOptions}"
                                            SelectedItem="{Binding SelectedHotkeyCategory, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Binding Mode" VerticalAlignment="Center"
                                        Foreground="#CCCCCC"
                                        FontWeight="SemiBold"/>
                                <ToggleSwitch IsChecked="{Binding IsHotkeyBindingMode, Mode=TwoWay}"
                                    hotkeys:HotkeyTarget.Path="IsHotkeyBindingMode"
                                            Foreground="#E6E6E6"/>
                                <TextBlock Text="{Binding HotkeyStatusMessage}"
                                        Foreground="#888888"
                                        FontSize="12"/>
                            </StackPanel>
                        </WrapPanel>
                        <Separator Margin="0,6,0,6"/>
                        <StackPanel IsVisible="{Binding IsGeneralHotkeyCategorySelected}" Spacing="6">
                            <TextBlock Text="Button/Toggle Bindings"
                                       Foreground="#CCCCCC"
                                       FontWeight="SemiBold"/>
                            <ListBox ItemsSource="{Binding CommandHotkeyBindings}"
                                     SelectedItem="{Binding SelectedHotkey, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="hk:HotkeyBindingViewModel">
                                        <Border>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding HotkeyDisplay}"
                                                           Foreground="#E6E6E6"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayLabel}"
                                                           Foreground="#CCCCCC"
                                                           VerticalAlignment="Center"/>
                                                <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                    <ToggleSwitch IsChecked="{Binding Enabled}"/>
                                                    <Button Content="Rebind"
                                                            Command="{Binding DataContext.RebindHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsCampathHotkeyCategorySelected}" Spacing="6">
                            <TextBlock Text="Campath Bindings"
                                       Foreground="#CCCCCC"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveCampathProfileName}"
                                       Foreground="#888888"
                                       FontSize="12"
                                       Margin="0,0,0,6"/>
                            <ListBox ItemsSource="{Binding CampathHotkeyBindings}"
                                     SelectedItem="{Binding SelectedHotkey, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="hk:HotkeyBindingViewModel">
                                        <Border>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding HotkeyDisplay}"
                                                           Foreground="#E6E6E6"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayLabel}"
                                                           Foreground="#CCCCCC"
                                                           VerticalAlignment="Center"/>
                                                <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                    <ToggleSwitch IsChecked="{Binding Enabled}" hotkeys:HotkeyTarget.Path="Enabled" />
                                                    <Button Content="Rebind"
                                                            Command="{Binding DataContext.RebindHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsGraphicsHotkeyCategorySelected}" Spacing="6">
                            <TextBlock Text="Graphics Bindings"
                                       Foreground="#CCCCCC"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveGraphicsProfileName}"
                                       Foreground="#888888"
                                       FontSize="12"
                                       Margin="0,0,0,6"/>
                            <ListBox ItemsSource="{Binding GraphicsHotkeyBindings}"
                                     SelectedItem="{Binding SelectedHotkey, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="hk:HotkeyBindingViewModel">
                                        <Border>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding HotkeyDisplay}"
                                                           Foreground="#E6E6E6"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayLabel}"
                                                           Foreground="#CCCCCC"
                                                           VerticalAlignment="Center"/>
                                                <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                    <ToggleSwitch IsChecked="{Binding Enabled}" />
                                                    <Button Content="Rebind"
                                                            Command="{Binding DataContext.RebindHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsAttachHotkeyCategorySelected}" Spacing="6">
                            <TextBlock Text="Attach Preset Bindings"
                                       Foreground="#CCCCCC"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveAttachPresetPageName}"
                                       Foreground="#888888"
                                       FontSize="12"
                                       Margin="0,0,0,6"/>
                            <ListBox ItemsSource="{Binding AttachHotkeyBindings}"
                                     SelectedItem="{Binding SelectedHotkey, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="hk:HotkeyBindingViewModel">
                                        <Border>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding HotkeyDisplay}"
                                                           Foreground="#E6E6E6"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayLabel}"
                                                           Foreground="#CCCCCC"
                                                           VerticalAlignment="Center"/>
                                                <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                    <ToggleSwitch IsChecked="{Binding Enabled}" />
                                                    <Button Content="Rebind"
                                                            Command="{Binding DataContext.RebindHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsCommandsHotkeyCategorySelected}" Spacing="6">
                            <TextBlock Text="Command Bindings"
                                       Foreground="#CCCCCC"
                                       FontWeight="SemiBold"/>
                            <Button Content="Add"
                                    HorizontalAlignment="Left"
                                    Command="{Binding AddCommandHotkeyCommand}" />
                            <ListBox ItemsSource="{Binding ExecCommandHotkeyBindings}"
                                     SelectedItem="{Binding SelectedHotkey, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="hk:HotkeyBindingViewModel">
                                        <Border>
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="8">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding HotkeyDisplay}"
                                                           Foreground="#E6E6E6"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" VerticalAlignment="Center"
                                                         PlaceholderText="spec_show_xray 1"
                                                         Text="{Binding TargetExecCommand, Mode=TwoWay}" />
                                                <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                                    <ToggleSwitch IsChecked="{Binding Enabled}" />
                                                    <Button Content="Bind"
                                                            Command="{Binding DataContext.RebindHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsVmixHotkeyCategorySelected}" Spacing="6">
                            <TextBlock Text="vMix Bindings"
                                       Foreground="#CCCCCC"
                                       FontWeight="SemiBold"/>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                <Button Content="Refresh vMix State"
                                        Command="{Binding RefreshVmixStateCommand}" />
                                <Button Content="Add"
                                        Command="{Binding AddVmixHotkeyCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding VmixStateStatusMessage}"
                                       Foreground="#888888"
                                       FontSize="12"/>
                            <ListBox ItemsSource="{Binding VmixHotkeyBindings}"
                                     SelectedItem="{Binding SelectedHotkey, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="hk:HotkeyBindingViewModel">
                                        <Border Padding="6" Margin="0,3,0,3">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                                  ColumnDefinitions="Auto,Auto,*,Auto"
                                                  RowSpacing="6"
                                                  ColumnSpacing="8">
                                                <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="20" LineSpacing="20">
                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                            Text="{Binding HotkeyDisplay}"
                                                            Foreground="#E6E6E6"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"/>
                                                    <ToggleSwitch Grid.Row="0" Grid.Column="0"
                                                                IsChecked="{Binding Enabled}"/>
                                                    <Button Grid.Row="0" Grid.Column="0"
                                                            Content="Bind"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.BindVmixHotkeyCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>

                                                <Button Grid.Row="0" Grid.Column="3"
                                                        Content="Remove"
                                                        Command="{Binding DataContext.RemoveHotkeyCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"/>

                                                <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                                            Text="Category"
                                                            Foreground="#AAAAAA"
                                                            VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                            ItemsSource="{Binding DataContext.VmixFunctionCategories, ElementName=Root}"
                                                            SelectedItem="{Binding TargetVmixFunctionCategory, Mode=TwoWay}"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                                            Text="Function"
                                                            Foreground="#AAAAAA"
                                                            VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                                            IsEditable="True"
                                                            ItemsSource="{Binding VmixFunctionOptions}"
                                                            Text="{Binding TargetVmixFunctionName, Mode=TwoWay}"/>
                                                </WrapPanel>

                                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Spacing="4">
                                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding VmixHasValueParameter}">
                                                        <TextBlock Text="Value" Width="70" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                                        <TextBox MinWidth="80" MaxWidth="260" Text="{Binding TargetVmixValue, Mode=TwoWay}" />
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding VmixHasInputParameter}">
                                                        <TextBlock Text="Input" Width="70" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                                        <ComboBox Width="260"
                                                                  ItemsSource="{Binding DataContext.VmixInputOptions, ElementName=Root}"
                                                                  SelectedItem="{Binding SelectedVmixInput, Mode=TwoWay}" />
                                                        <TextBox MinWidth="40" MaxWidth="80"
                                                                 PlaceholderText="#"
                                                                 Text="{Binding TargetVmixInputNumber, Mode=TwoWay}" />
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding VmixHasChannelParameter}">
                                                        <TextBlock Text="Channel" Width="70" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                                        <ComboBox Width="180"
                                                                  IsEditable="True"
                                                                  Text="{Binding TargetVmixChannel, Mode=TwoWay}">
                                                            <ComboBoxItem Content="A" />
                                                            <ComboBoxItem Content="B" />
                                                        </ComboBox>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding VmixHasDurationParameter}">
                                                        <TextBlock Text="Duration" Width="70" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                                        <TextBox MinWidth="80" MaxWidth="180" Text="{Binding TargetVmixDuration, Mode=TwoWay}" />
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding VmixHasCustomParameter}">
                                                        <TextBlock Text="Extra" Width="70" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                                        <TextBox MinWidth="80" MaxWidth="360"
                                                                 PlaceholderText="key=value&amp;key2=value2"
                                                                 Text="{Binding TargetVmixExtraQuery, Mode=TwoWay}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Freecam">
                <TabControl Margin="10">
                    <TabItem Header="Camera">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="8">
                                <Expander Header="Mouse &amp; movement" IsExpanded="True" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Mouse" Foreground="#CCCCCC" FontWeight="SemiBold" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Mouse Sensitivity" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.MouseSensitivity, StringFormat={}{0:F3}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.01" Maximum="1.0" SmallChange="0.01" LargeChange="0.1" Value="{Binding FreecamSettings.MouseSensitivity, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <ToggleSwitch IsChecked="{Binding FreecamSettings.ClampPitch, Mode=TwoWay}" Content="Clamp Pitch" hotkeys:HotkeyTarget.Path="FreecamSettings.ClampPitch" Foreground="#E6E6E6" />
                                        </WrapPanel>
                                        <TextBlock Text="Movement" Foreground="#CCCCCC" FontWeight="SemiBold" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Move Speed" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.MoveSpeed, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="10.0" Maximum="1000.0" SmallChange="10.0" LargeChange="50.0" Value="{Binding FreecamSettings.MoveSpeed, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Sprint Multiplier" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.SprintMultiplier, StringFormat={}{0:F1}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="1.0" Maximum="5.0" SmallChange="0.1" LargeChange="0.5" Value="{Binding FreecamSettings.SprintMultiplier, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Vertical Speed" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.VerticalSpeed, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="10.0" Maximum="1000.0" SmallChange="10.0" LargeChange="50.0" Value="{Binding FreecamSettings.VerticalSpeed, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Speed Adjust Rate" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.SpeedAdjustRate, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="1.0" Maximum="2.0" SmallChange="0.01" LargeChange="0.1" Value="{Binding FreecamSettings.SpeedAdjustRate, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Speed Min Multiplier" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.SpeedMinMultiplier, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.01" Maximum="1.0" SmallChange="0.01" LargeChange="0.1" Value="{Binding FreecamSettings.SpeedMinMultiplier, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Speed Max Multiplier" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.SpeedMaxMultiplier, StringFormat={}{0:F1}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="1.0" Maximum="10.0" SmallChange="0.5" LargeChange="1.0" Value="{Binding FreecamSettings.SpeedMaxMultiplier, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <ToggleSwitch IsChecked="{Binding FreecamSettings.HoldMovementFollowsCamera, Mode=TwoWay}" Content="Hold follows camera rotation" hotkeys:HotkeyTarget.Path="FreecamSettings.HoldMovementFollowsCamera" Foreground="#E6E6E6" />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Smoothing" IsExpanded="False" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <ToggleSwitch IsChecked="{Binding FreecamSettings.SmoothEnabled, Mode=TwoWay}" Content="Enable Smoothing" hotkeys:HotkeyTarget.Path="FreecamSettings.SmoothEnabled" Foreground="#E6E6E6" />
                                        <ToggleSwitch IsChecked="{Binding FreecamSettings.RotCriticalDamping, Mode=TwoWay}" Content="Use Damping (Rotation)" hotkeys:HotkeyTarget.Path="FreecamSettings.RotCriticalDamping" Foreground="#E6E6E6" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Rotation Damping Ratio (&gt;= 1.0)" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.RotDampingRatio, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="1.0" Maximum="5.0" SmallChange="0.1" LargeChange="0.5" Value="{Binding FreecamSettings.RotDampingRatio, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Position Half-time (s)" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.HalfVec, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.05" Maximum="2.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding FreecamSettings.HalfVec, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Rotation Half-time (s)" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.HalfRot, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.05" Maximum="2.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding FreecamSettings.HalfRot, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="FOV Half-time (s)" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.HalfFov, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.05" Maximum="2.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding FreecamSettings.HalfFov, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Lock Half-time (s)" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.LockHalfRot, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.05" Maximum="2.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding FreecamSettings.LockHalfRot, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Lock Half-time Transition (s)" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.LockHalfRotTransition, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.05" Maximum="2.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding FreecamSettings.LockHalfRotTransition, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Roll &amp; lean" IsExpanded="False" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Roll Speed" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.RollSpeed, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="10.0" Maximum="180.0" SmallChange="5.0" LargeChange="15.0" Value="{Binding FreecamSettings.RollSpeed, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Roll Smoothing" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.RollSmoothing, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding FreecamSettings.RollSmoothing, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Lean Strength" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.LeanStrength, StringFormat={}{0:F1}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="2.0" SmallChange="0.1" LargeChange="0.5" Value="{Binding FreecamSettings.LeanStrength, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Lean Accel Scale" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.LeanAccelScale, StringFormat={}{0:F4}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="0.1" SmallChange="0.001" LargeChange="0.01" Value="{Binding FreecamSettings.LeanAccelScale, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Lean Velocity Scale" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.LeanVelocityScale, StringFormat={}{0:F3}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="0.1" SmallChange="0.001" LargeChange="0.01" Value="{Binding FreecamSettings.LeanVelocityScale, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Lean Max Angle" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.LeanMaxAngle, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="45.0" SmallChange="1.0" LargeChange="5.0" Value="{Binding FreecamSettings.LeanMaxAngle, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Lean Half-time (s)" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.LeanHalfTime, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.01" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" Value="{Binding FreecamSettings.LeanHalfTime, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="FOV" IsExpanded="False" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="FOV Min" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.FovMin, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="5.0" Maximum="90.0" SmallChange="1.0" LargeChange="5.0" Value="{Binding FreecamSettings.FovMin, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="FOV Max" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.FovMax, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="90.0" Maximum="180.0" SmallChange="5.0" LargeChange="10.0" Value="{Binding FreecamSettings.FovMax, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="FOV Step" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.FovStep, StringFormat={}{0:F1}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.5" Maximum="10.0" SmallChange="0.5" LargeChange="1.0" Value="{Binding FreecamSettings.FovStep, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Default FOV" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.DefaultFov, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="60.0" Maximum="120.0" SmallChange="1.0" LargeChange="5.0" Value="{Binding FreecamSettings.DefaultFov, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                                <Button Content="Reset to Default" Command="{Binding ResetFreecamSettingsCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Controls">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="10">
                                    <ToggleSwitch IsChecked="{Binding FreecamSettings.SwapRightClickInitMode, Mode=TwoWay}" Content="Swap RMB/Hold CapsLock+RMB init mode" hotkeys:HotkeyTarget.Path="FreecamSettings.SwapRightClickInitMode" Foreground="#E6E6E6" />
                                <TextBlock Text="Analog Keyboard" Foreground="#CCCCCC" FontWeight="SemiBold" />
                                    <ToggleSwitch IsChecked="{Binding FreecamSettings.AnalogKeyboardEnabled, Mode=TwoWay}" Content="Enable analog keyboard mode" hotkeys:HotkeyTarget.Path="FreecamSettings.AnalogKeyboardEnabled" Foreground="#E6E6E6" />
                                <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                    <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="Left Stick Deadzone" Foreground="#CCCCCC" />
                                            <TextBlock Text="{Binding FreecamSettings.AnalogLeftDeadzone, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05" Value="{Binding FreecamSettings.AnalogLeftDeadzone, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="Right Stick Deadzone" Foreground="#CCCCCC" />
                                            <TextBlock Text="{Binding FreecamSettings.AnalogRightDeadzone, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05" Value="{Binding FreecamSettings.AnalogRightDeadzone, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="Analog Curve" Foreground="#CCCCCC" />
                                            <TextBlock Text="{Binding FreecamSettings.AnalogCurve, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding FreecamSettings.AnalogCurve, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="Sprint uses right stick X+." Foreground="#888888" FontSize="12" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Walk">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="8">
                                <Expander Header="Movement" IsExpanded="True" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Movement" Foreground="#CCCCCC" FontWeight="SemiBold" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Move Speed" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkMoveSpeed, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="10.0" Maximum="500.0" SmallChange="5.0" LargeChange="25.0" Value="{Binding FreecamSettings.WalkMoveSpeed, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Move Acceleration" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkMoveAcceleration, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="10.0" Maximum="3000.0" SmallChange="10.0" LargeChange="100.0" Value="{Binding FreecamSettings.WalkMoveAcceleration, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Move Deceleration" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkMoveDeceleration, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="10.0" Maximum="3000.0" SmallChange="10.0" LargeChange="100.0" Value="{Binding FreecamSettings.WalkMoveDeceleration, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Run Multiplier" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkRunMultiplier, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="1.0" Maximum="4.0" SmallChange="0.05" LargeChange="0.25" Value="{Binding FreecamSettings.WalkRunMultiplier, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Crouch Speed Multiplier" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkCrouchSpeedMultiplier, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.1" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" Value="{Binding FreecamSettings.WalkCrouchSpeedMultiplier, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Gravity" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkGravity, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="100.0" Maximum="2000.0" SmallChange="25.0" LargeChange="100.0" Value="{Binding FreecamSettings.WalkGravity, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Jump Speed" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkJumpSpeed, StringFormat={}{0:F0}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="50.0" Maximum="600.0" SmallChange="10.0" LargeChange="25.0" Value="{Binding FreecamSettings.WalkJumpSpeed, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="Walk mode uses analog WASD, analog sprint on right-stick X+, and analog crouch on down/right-stick Y-." Foreground="#888888" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Smoothing &amp; collision" IsExpanded="False" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Smoothing" Foreground="#CCCCCC" FontWeight="SemiBold" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Look Half-time" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkLookHalfTime, StringFormat={}{0:F3}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.01" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" Value="{Binding FreecamSettings.WalkLookHalfTime, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="FOV Half-time" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkFovHalfTime, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.01" Maximum="1.5" SmallChange="0.01" LargeChange="0.05" Value="{Binding FreecamSettings.WalkFovHalfTime, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="Collision" Foreground="#CCCCCC" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Hull Radius" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkHullRadius, StringFormat={}{0:F1}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="2.0" Maximum="32.0" SmallChange="1.0" LargeChange="2.0" Value="{Binding FreecamSettings.WalkHullRadius, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Standing Half-height" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkHullHalfHeight, StringFormat={}{0:F1}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="8.0" Maximum="64.0" SmallChange="1.0" LargeChange="4.0" Value="{Binding FreecamSettings.WalkHullHalfHeight, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Crouch Half-height" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkCrouchHullHalfHeight, StringFormat={}{0:F1}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="8.0" Maximum="64.0" SmallChange="1.0" LargeChange="4.0" Value="{Binding FreecamSettings.WalkCrouchHullHalfHeight, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Camera Top Inset" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkCameraTopInset, StringFormat={}{0:F1}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="16.0" SmallChange="0.5" LargeChange="1.0" Value="{Binding FreecamSettings.WalkCameraTopInset, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Step Height" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkStepHeight, StringFormat={}{0:F1}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="48.0" SmallChange="1.0" LargeChange="2.0" Value="{Binding FreecamSettings.WalkStepHeight, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Ground Probe" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkGroundProbe, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="8.0" SmallChange="0.25" LargeChange="0.5" Value="{Binding FreecamSettings.WalkGroundProbe, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Ground Normal Z" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkMinGroundNormalZ, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.1" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" Value="{Binding FreecamSettings.WalkMinGroundNormalZ, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <ToggleSwitch IsChecked="{Binding FreecamSettings.WalkModeDefaultEnabled, Mode=TwoWay}" Content="Walk mode enabled by default" Foreground="#E6E6E6" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Handheld">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="8">
                                <Expander Header="Shake &amp; walk bob" IsExpanded="True" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Shake" Foreground="#CCCCCC" FontWeight="SemiBold" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Position Amplitude" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.HandheldShakePosAmplitude, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="5.0" SmallChange="0.05" LargeChange="0.25" Value="{Binding FreecamSettings.HandheldShakePosAmplitude, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Angle Amplitude" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.HandheldShakeAngAmplitude, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="5.0" SmallChange="0.05" LargeChange="0.25" Value="{Binding FreecamSettings.HandheldShakeAngAmplitude, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Frequency" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.HandheldShakeFrequency, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="2.0" SmallChange="0.01" LargeChange="0.05" Value="{Binding FreecamSettings.HandheldShakeFrequency, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="Walk bob" Foreground="#CCCCCC" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Amplitude Z" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkBobAmplitudeZ, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="8.0" SmallChange="0.05" LargeChange="0.25" Value="{Binding FreecamSettings.WalkBobAmplitudeZ, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Amplitude Side" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkBobAmplitudeSide, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="8.0" SmallChange="0.05" LargeChange="0.25" Value="{Binding FreecamSettings.WalkBobAmplitudeSide, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Amplitude Roll" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkBobAmplitudeRoll, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="8.0" SmallChange="0.05" LargeChange="0.25" Value="{Binding FreecamSettings.WalkBobAmplitudeRoll, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Bob Frequency" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.WalkBobFrequency, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="3.0" SmallChange="0.01" LargeChange="0.05" Value="{Binding FreecamSettings.WalkBobFrequency, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Drift" IsExpanded="False" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Drift" Foreground="#CCCCCC" FontWeight="SemiBold" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Position Amplitude" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.HandheldDriftPosAmplitude, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="10.0" SmallChange="0.05" LargeChange="0.25" Value="{Binding FreecamSettings.HandheldDriftPosAmplitude, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Angle Amplitude" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.HandheldDriftAngAmplitude, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="10.0" SmallChange="0.05" LargeChange="0.25" Value="{Binding FreecamSettings.HandheldDriftAngAmplitude, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" MinWidth="190" MaxWidth="280">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="Frequency" Foreground="#CCCCCC" />
                                                    <TextBlock Text="{Binding FreecamSettings.HandheldDriftFrequency, StringFormat={}{0:F2}}" Foreground="#E6E6E6" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" Value="{Binding FreecamSettings.HandheldDriftFrequency, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="170" MaxWidth="280" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <ToggleSwitch IsChecked="{Binding FreecamSettings.HandheldDefaultEnabled, Mode=TwoWay}" Content="Handheld enabled by default for regular freecam" Foreground="#E6E6E6" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            </TabControl>
        </Border>

        <Border Background="#1E1E1E" Padding="10" Focusable="True"
                IsVisible="{Binding IsEditingAttachPresetAnimation}">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                    <Button Content="Back"
                            Command="{Binding CloseAttachPresetAnimationCommand}"/>
                    <TextBlock Text="{Binding AttachPresetAnimationEditor.Title}"
                               Foreground="#E6E6E6"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </WrapPanel>
                <docks:AttachPresetAnimationDockView Grid.Row="1"
                                                     DataContext="{Binding AttachPresetAnimationEditor}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
