<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HlaeObsTools.ViewModels.Docks" xmlns:conv="using:HlaeObsTools.Converters" xmlns:hotkeys="using:HlaeObsTools.Services.Hotkeys" xmlns:controls="clr-namespace:HlaeObsTools.Controls" x:Class="HlaeObsTools.Views.Docks.GraphicsDockView" x:DataType="vm:GraphicsDockViewModel" x:Name="Root">
  <UserControl.Resources>
    <conv:DoubleTextConverter x:Key="DoubleText" DefaultValue="0" />
    <conv:DoubleTextConverter x:Key="PreciseUvText" DefaultValue="0" Format="0.########" />
  </UserControl.Resources>
  <Border Background="#1E1E1E" Padding="10" Focusable="True">
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsSetupView, Converter={StaticResource BooleanNegationConverter}}">
          <Button Content="Reload All" Command="{Binding ReloadAllCommand}" Margin="0,0,8,8" />
          <Button Content="Show All" Command="{Binding ShowAllCommand}" Margin="0,0,8,8" />
          <Button Content="Hide All" Command="{Binding HideAllCommand}" Margin="0,0,8,8" />
          <Button Content="Apply" Command="{Binding ApplyCommand}" Margin="0,0,8,8" />
          <Button Content="Setup" Command="{Binding ShowSetupCommand}" Margin="0,0,8,8" />
        </WrapPanel>
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsSetupView}">
          <Button Content="Back" Command="{Binding ShowLiveCommand}" Margin="0,0,8,8" />
          <TextBlock Text="Profile" VerticalAlignment="Center" Foreground="#B0B0B0" Margin="0,0,6,8" />
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" SelectionChanged="OnProfileSelectionChanged" VerticalAlignment="Center" Margin="0,0,8,8">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="..." FontWeight="ExtraBold" FontSize="16" Margin="0,0,8,8">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="New" Click="OnNewProfileClick" />
                <MenuItem Header="Save As" Click="OnSaveProfileClick" IsVisible="{Binding IsEmptyProfile}" />
                <MenuItem Header="Rename" Click="OnRenameProfileClick" IsVisible="{Binding CanManageSelectedProfile}" />
                <MenuItem Header="Duplicate" Click="OnDuplicateProfileClick" />
                <MenuItem Header="Save" Click="OnSaveCurrentProfileClick" IsVisible="{Binding CanManageSelectedProfile}" />
                <Separator />
                <MenuItem Header="Delete Profile" Click="OnRemoveProfileClick" IsEnabled="{Binding CanRemoveSelectedProfile}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Content="Apply" Command="{Binding ApplyCommand}" Margin="0,0,8,8" />
        </WrapPanel>
      </Grid>
      <Grid Grid.Row="1" IsVisible="{Binding IsSetupView, Converter={StaticResource BooleanNegationConverter}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16">
            <StackPanel Spacing="6">
              <TextBlock Text="ATLASES" Foreground="#B0B0B0" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Atlases}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ResponsiveCardPanel MinimumCardWidth="200" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#292929" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="10">
                      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                          <ToggleButton IsChecked="{Binding Enabled}" Width="32" Height="28" Padding="0" ToolTip.Tip="Atlas enabled">
                            <Grid>
                              <controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-power.svg" SvgCss="path { stroke: #68727D; }" IsVisible="{Binding Enabled, Converter={StaticResource BooleanNegationConverter}}" Width="18" Height="18" />
                              <controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-power.svg" SvgCss="path { stroke: #5FCB75; }" IsVisible="{Binding Enabled}" Width="18" Height="18" />
                            </Grid>
                          </ToggleButton>
                          <ToggleButton IsChecked="{Binding InstancesVisible}" Width="32" Height="28" Padding="0" ToolTip.Tip="Show or hide atlas instances"><Grid><controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-eye-off.svg" SvgCss="path { stroke: #68727D; }" IsVisible="{Binding InstancesVisible, Converter={StaticResource BooleanNegationConverter}}" Width="18" Height="18" /><controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-eye.svg" SvgCss="path { stroke: #59B8FF; }" IsVisible="{Binding InstancesVisible}" Width="18" Height="18" /></Grid></ToggleButton>
                          <Button Width="32" Height="28" Padding="0" ToolTip.Tip="Reload atlas" Command="{Binding DataContext.ReloadAtlasCommand, ElementName=Root}" CommandParameter="{Binding}" hotkeys:HotkeyTarget.GraphicsAtlasName="{Binding Name}" hotkeys:HotkeyTarget.GraphicsAction="reload"><controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-reload.svg" SvgCss="path { stroke: #C7D1DD; }" Width="18" Height="18" /></Button>
                          <Button Width="32" Height="28" Padding="0" ToolTip.Tip="Animate in" Command="{Binding DataContext.AnimInAtlasCommand, ElementName=Root}" CommandParameter="{Binding}" hotkeys:HotkeyTarget.GraphicsAtlasName="{Binding Name}" hotkeys:HotkeyTarget.GraphicsAction="anim_in"><controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-anim-in.svg" SvgCss="path { stroke: #C7D1DD; }" Width="18" Height="18" /></Button>
                          <Button Width="32" Height="28" Padding="0" ToolTip.Tip="Animate out" Command="{Binding DataContext.AnimOutAtlasCommand, ElementName=Root}" CommandParameter="{Binding}" hotkeys:HotkeyTarget.GraphicsAtlasName="{Binding Name}" hotkeys:HotkeyTarget.GraphicsAction="anim_out"><controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-anim-out.svg" SvgCss="path { stroke: #C7D1DD; }" Width="18" Height="18" /></Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="INSTANCES" Foreground="#B0B0B0" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Instances}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ResponsiveCardPanel MinimumCardWidth="125" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#292929" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="10">
                      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                          <ToggleButton IsChecked="{Binding LiveVisible}" Width="32" Height="28" Padding="0" ToolTip.Tip="Show or hide instance"><Grid><controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-eye-off.svg" SvgCss="path { stroke: #68727D; }" IsVisible="{Binding LiveVisible, Converter={StaticResource BooleanNegationConverter}}" Width="18" Height="18" /><controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-eye.svg" SvgCss="path { stroke: #59B8FF; }" IsVisible="{Binding LiveVisible}" Width="18" Height="18" /></Grid></ToggleButton>
                          <Button Width="32" Height="28" Padding="0" ToolTip.Tip="Animate in" Command="{Binding DataContext.AnimInInstanceCommand, ElementName=Root}" CommandParameter="{Binding}" hotkeys:HotkeyTarget.GraphicsInstanceName="{Binding Name}" hotkeys:HotkeyTarget.GraphicsAction="anim_in"><controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-anim-in.svg" SvgCss="path { stroke: #C7D1DD; }" Width="18" Height="18" /></Button>
                          <Button Width="32" Height="28" Padding="0" ToolTip.Tip="Animate out" Command="{Binding DataContext.AnimOutInstanceCommand, ElementName=Root}" CommandParameter="{Binding}" hotkeys:HotkeyTarget.GraphicsInstanceName="{Binding Name}" hotkeys:HotkeyTarget.GraphicsAction="anim_out"><controls:GraphicsIcon IconPath="avares://HlaeObsTools/Assets/icons/graphics-anim-out.svg" SvgCss="path { stroke: #C7D1DD; }" Width="18" Height="18" /></Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid Grid.Row="1" IsVisible="{Binding IsSetupView}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" MinWidth="140" MaxWidth="450" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="*" MinWidth="180" />
        </Grid.ColumnDefinitions>
        <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="6">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Paste" Click="OnPasteClick" />
            </ContextMenu>
          </Border.ContextMenu>
          <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ATLASES" Foreground="#B0B0B0" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="+" Click="OnAddAtlasClick" ToolTip.Tip="Add atlas" />
              </Grid>
              <ListBox ItemsSource="{Binding Atlases}" SelectedItem="{Binding SelectedAtlasNavigation}" x:Name="AtlasList">
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Duplicate" Command="{Binding DuplicateSelectedCommand}" />
                    <MenuItem Header="Copy" Click="OnCopyClick" />
                    <MenuItem Header="Paste" Click="OnPasteClick" />
                    <Separator />
                    <MenuItem Header="Delete" Command="{Binding DeleteSelectedCommand}" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{Binding NavigationBackground}" HorizontalAlignment="Stretch" PointerPressed="OnAtlasItemPointerPressed">
                      <StackPanel Margin="4,3">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Width}" Foreground="#8D99A5" FontSize="11" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Margin="14,0,0,0" Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="REGIONS" Foreground="#B0B0B0" FontWeight="SemiBold" />
                  <Button Grid.Column="1" Content="+" Click="OnAddRegionClick" ToolTip.Tip="Add region" />
                </Grid>
                <ListBox ItemsSource="{Binding SelectedAtlas.Regions}" SelectedItems="{Binding SelectedRegions}" SelectionMode="Multiple" x:Name="RegionList" SelectionChanged="OnRegionSelectionChanged">
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Duplicate" Command="{Binding DuplicateSelectedCommand}" />
                      <MenuItem Header="Copy" Click="OnCopyClick" />
                      <MenuItem Header="Paste" Click="OnPasteClick" />
                      <Separator />
                      <MenuItem Header="Delete" Command="{Binding DeleteSelectedCommand}" />
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="Transparent" HorizontalAlignment="Stretch" PointerPressed="OnRegionItemPointerPressed">
                        <TextBlock Text="{Binding Id}" Margin="4,3" />
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="INSTANCES" Foreground="#B0B0B0" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="+" Click="OnAddInstanceClick" ToolTip.Tip="Add instance" />
              </Grid>
              <ListBox ItemsSource="{Binding Instances}" SelectedItems="{Binding SelectedInstances}" SelectionMode="Multiple" x:Name="InstanceList" SelectionChanged="OnInstanceSelectionChanged">
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Duplicate" Command="{Binding DuplicateSelectedCommand}" />
                    <MenuItem Header="Copy" Click="OnCopyClick" />
                    <MenuItem Header="Paste" Click="OnPasteClick" />
                    <Separator />
                    <MenuItem Header="Delete" Command="{Binding DeleteSelectedCommand}" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="Transparent" HorizontalAlignment="Stretch" PointerPressed="OnInstanceItemPointerPressed">
                      <StackPanel Margin="4,3">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding SourceSummary}" Foreground="#8D99A5" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <GridSplitter Grid.Column="1" Background="#4A4A4A" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" />
        <Border Grid.Column="2" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding SelectedItemTitle}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Select an atlas, region, or instance from the outline to edit it." Foreground="#9AA5B1" IsVisible="{Binding HasSelection, Converter={StaticResource BooleanNegationConverter}}" />
              <StackPanel Spacing="8" IsVisible="{Binding HasSelectedAtlas}">
                <TextBlock Text="Atlas" Foreground="#B0B0B0" FontWeight="SemiBold" />
                <StackPanel Spacing="2">
                  <TextBlock Text="Name" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedAtlas.Name, Mode=TwoWay}" PlaceholderText="Atlas name" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Width" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding SelectedAtlas.Width, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Height" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding SelectedAtlas.Height, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="2">
                  <TextBlock Text="HTML Path" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedAtlas.HtmlPath, Mode=TwoWay}" PlaceholderText="HTML path" />
                </StackPanel>
                <ToggleSwitch IsChecked="{Binding SelectedAtlas.Enabled}" Content="Enabled" />
              </StackPanel>
              <StackPanel Spacing="8" IsVisible="{Binding HasSelectedRegion}">
                <TextBlock Text="Region" Foreground="#B0B0B0" FontWeight="SemiBold" />
                <StackPanel Spacing="2">
                  <TextBlock Text="Region ID" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding RegionIdValue, Mode=TwoWay}" IsReadOnly="{Binding HasMultipleRegions}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="U0" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding RegionU0Value, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="V0" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding RegionV0Value, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="U1" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding RegionU1Value, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="V1" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding RegionV1Value, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Default Width" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding RegionDefaultWidthValue, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Default Height" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding RegionDefaultHeightValue, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
              <StackPanel Spacing="8" IsVisible="{Binding HasSelectedInstance}">
                <TextBlock Text="Instance" Foreground="#B0B0B0" FontWeight="SemiBold" />
                <StackPanel Spacing="2">
                  <TextBlock Text="Name" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding InstanceNameValue, Mode=TwoWay}" IsReadOnly="{Binding HasMultipleInstances}" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Source" Foreground="#B0B0B0" />
                  <ComboBox ItemsSource="{Binding InstanceSourceOptions}" SelectedItem="{Binding SelectedInstanceSource}" PlaceholderText="—">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsAtlasSourceSelected}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Atlas" Foreground="#B0B0B0" />
                    <ComboBox ItemsSource="{Binding Atlases}" SelectedItem="{Binding SelectedInstanceAtlas}" PlaceholderText="—">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Text="Region" Foreground="#B0B0B0" />
                    <ComboBox ItemsSource="{Binding SelectedInstanceAtlas.Regions}" SelectedItem="{Binding SelectedInstanceRegion}" PlaceholderText="—">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Id}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </WrapPanel>
                <StackPanel Spacing="2" IsVisible="{Binding IsImageSourceSelected}">
                  <TextBlock Text="Image" Foreground="#B0B0B0" />
                  <WrapPanel ItemSpacing="8">
                    <ComboBox ItemsSource="{Binding AvailableImages}" SelectedItem="{Binding SelectedInstanceImageFile}" PlaceholderText="—" MinWidth="40" />
                    <Button Content="Refresh" Command="{Binding RefreshImagesCommand}" />
                  </WrapPanel>
                </StackPanel>
                <TextBlock Text="Attachment" Foreground="#B0B0B0" FontWeight="SemiBold" Margin="0,8,0,0" />
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Attach Slot" Foreground="#B0B0B0" />
                    <ComboBox ItemsSource="{Binding AttachSlotOptions}" SelectedItem="{Binding SelectedInstanceAttachSlot}" PlaceholderText="—">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Text="Attachment" Foreground="#B0B0B0" />
                    <ComboBox ItemsSource="{Binding AttachAttachmentOptions}" SelectedItem="{Binding SelectedInstanceAttachment}" PlaceholderText="—">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Text="Bone" Foreground="#B0B0B0" />
                    <ComboBox ItemsSource="{Binding AttachBoneOptions}" SelectedItem="{Binding SelectedInstanceBone}" PlaceholderText="—">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </WrapPanel>
                <WrapPanel ItemSpacing="12">
                  <CheckBox IsThreeState="True" IsChecked="{Binding InstanceAttachUseYawValue}" Content="Use Yaw" />
                  <CheckBox IsThreeState="True" IsChecked="{Binding InstanceAttachUsePitchValue}" Content="Use Pitch" />
                  <CheckBox IsThreeState="True" IsChecked="{Binding InstanceAttachUseRollValue}" Content="Use Roll" />
                </WrapPanel>
                <TextBlock Text="Transform" Foreground="#B0B0B0" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Position X" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding InstancePosXValue, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Position Y" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding InstancePosYValue, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="Position Z" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding InstancePosZValue, Mode=TwoWay}" />
                  </StackPanel>
                  <Button Grid.Column="3" Content="Get" Command="{Binding GetCurrentCameraPositionCommand}" VerticalAlignment="Bottom" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Pitch" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding InstancePitchValue, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Yaw" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding InstanceYawValue, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="Roll" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding InstanceRollValue, Mode=TwoWay}" />
                  </StackPanel>
                  <Button Grid.Column="3" Content="Get" Command="{Binding GetCurrentCameraRotationCommand}" VerticalAlignment="Bottom" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Scale X" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding InstanceScaleXValue, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Scale Y" Foreground="#B0B0B0" />
                    <TextBox Text="{Binding InstanceScaleYValue, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
                <WrapPanel ItemSpacing="12">
                  <CheckBox IsThreeState="True" IsChecked="{Binding InstanceVisibleValue}" Content="Visible" />
                  <CheckBox IsThreeState="True" IsChecked="{Binding InstanceDepthTestValue}" Content="Depth test" />
                  <CheckBox IsThreeState="True" IsChecked="{Binding InstanceDepthWriteValue}" Content="Depth write" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      <Border Grid.RowSpan="2" IsVisible="{Binding IsToastVisible}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0" Background="#DD252525" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="12,8" ZIndex="10">
        <TextBlock Text="{Binding ToastMessage}" Foreground="#F2F2F2" TextWrapping="Wrap" MaxWidth="360" />
      </Border>
    </Grid>
  </Border>
</UserControl>
