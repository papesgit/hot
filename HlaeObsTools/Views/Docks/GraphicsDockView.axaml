<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HlaeObsTools.ViewModels.Docks"
             xmlns:conv="using:HlaeObsTools.Converters"
             x:Class="HlaeObsTools.Views.Docks.GraphicsDockView"
             x:DataType="vm:GraphicsDockViewModel"
             x:Name="Root"
             xmlns:controls="clr-namespace:HlaeObsTools.Controls">
  <UserControl.Resources>
    <conv:DoubleTextConverter x:Key="DoubleText" DefaultValue="0" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="HeaderedContentControl">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border ZIndex="1"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    Padding="5,0,5,0"
                    Margin="5,0,0,0">
              <TextBlock Text="{TemplateBinding Header}"
                         FontWeight="Bold"/>
            </Border>

            <Border Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    Padding="0,5,0,0"
                    CornerRadius="4"
                    Margin="0,10,0,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1">
              <ContentPresenter Name="PART_ContentPresenter"
                                Padding="8"
                                Content="{TemplateBinding Content}"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>
  <Border Background="#1E1E1E" Padding="10">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding IsSetupView, Converter={StaticResource BooleanNegationConverter}}">
          <Button Content="Reload All" Command="{Binding ReloadAllCommand}" />
          <Button Content="Show All" Command="{Binding ShowAllCommand}" />
          <Button Content="Hide All" Command="{Binding HideAllCommand}" />
          <Button Content="Apply" Command="{Binding ApplyCommand}" />
          <Button Content="Setup" Command="{Binding ShowSetupCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSetupView}">
          <Button Content="Back" Command="{Binding ShowLiveCommand}" />
          <Button Content="Apply" Command="{Binding ApplyCommand}" />
          <Button Content="Save Profile" Click="OnSaveProfileClick" />
          <ComboBox ItemsSource="{Binding Profiles}"
                    SelectedItem="{Binding SelectedProfileName}"
                    Width="120" />
          <Button Content="Remove" Click="OnRemoveProfileClick" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1"
            IsVisible="{Binding IsSetupView, Converter={StaticResource BooleanNegationConverter}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">


          <TextBlock Text="Atlases" Foreground="#B0B0B0" />
          <ListBox ItemsSource="{Binding Atlases}" SelectedItem="{Binding SelectedAtlas}" Background="#292929" BorderBrush="#2E2E2E" Focusable="False">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="4">
                  <StackPanel Orientation="Vertical">
                  <TextBlock Text="{Binding Name}" Foreground="#E0E0E0" />
                  <TextBlock Text="{Binding Width}" Foreground="#9AA5B1" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Grid.Column="1" HorizontalAlignment="Left">
                  <Button Content="AnimIn"
                          Command="{Binding DataContext.AnimInAtlasCommand, ElementName=Root}"
                          CommandParameter="{Binding}" />
                  <Button Content="AnimOut"
                          Command="{Binding DataContext.AnimOutAtlasCommand, ElementName=Root}"
                          CommandParameter="{Binding}" />
                  </StackPanel>
                  <Button Grid.Column="4"
                          Content="Reload"
                          Command="{Binding DataContext.ReloadAtlasCommand, ElementName=Root}"
                          CommandParameter="{Binding}" />
                  <ToggleSwitch Grid.Column="5" IsChecked="{Binding InstancesVisible}" Content="Show" />
                  <ToggleSwitch Grid.Column="6" IsChecked="{Binding Enabled}" Content="On" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="Instances" Foreground="#B0B0B0" Margin="0,6,0,0" />
          <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Background="#292929" BorderBrush="#2E2E2E" Focusable="False">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="4">
                  <StackPanel Orientation="Vertical">
                  <TextBlock Text="{Binding Name}" Foreground="#E0E0E0" />
                  <TextBlock Text="{Binding Atlas}" Foreground="#9AA5B1" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Grid.Column="1" HorizontalAlignment="Left">
                  <Button Content="AnimIn"
                          Command="{Binding DataContext.AnimInInstanceCommand, ElementName=Root}"
                          CommandParameter="{Binding}" />
                  <Button Content="AnimOut"
                          Command="{Binding DataContext.AnimOutInstanceCommand, ElementName=Root}"
                          CommandParameter="{Binding}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="4" IsChecked="{Binding Visible}" Content="Show" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Row="1" IsVisible="{Binding IsSetupView}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">


          <HeaderedContentControl Header="Atlas Setup">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add" Click="OnAddAtlasClick" />
                <Button Content="Remove" Command="{Binding RemoveAtlasCommand}" />
                <TextBlock Text="Atlas" VerticalAlignment="Center" Foreground="#B0B0B0" />
                <ComboBox ItemsSource="{Binding Atlases}"
                          SelectedItem="{Binding SelectedAtlas}"
                          MinWidth="160">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="Name" Foreground="#B0B0B0" />
                <TextBox Text="{Binding SelectedAtlas.Name, Mode=TwoWay}" Watermark="Name" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="Width" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedAtlas.Width, Mode=TwoWay}" Watermark="Width" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Height" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedAtlas.Height, Mode=TwoWay}" Watermark="Height" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="2">
                <TextBlock Text="HTML Path" Foreground="#B0B0B0" />
                <TextBox Text="{Binding SelectedAtlas.HtmlPath, Mode=TwoWay}" Watermark="HTML path" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Enabled" VerticalAlignment="Center" Foreground="#B0B0B0" />
                <ToggleSwitch IsChecked="{Binding SelectedAtlas.Enabled}" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Header="Region Editor">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add" Click="OnAddRegionClick" />
                <Button Content="Remove" Command="{Binding RemoveRegionCommand}" />
                <TextBlock Text="Region" VerticalAlignment="Center" Foreground="#B0B0B0" />
                <ComboBox ItemsSource="{Binding SelectedAtlas.Regions}"
                          SelectedItem="{Binding SelectedRegion}"
                          MinWidth="160">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Id}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="Region Id" Foreground="#B0B0B0" />
                <TextBox Text="{Binding SelectedRegion.Id, Mode=TwoWay}" Watermark="Region Id" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="U0" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedRegion.U0, Mode=TwoWay, Converter={StaticResource DoubleText}}" Watermark="U0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="V0" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedRegion.V0, Mode=TwoWay, Converter={StaticResource DoubleText}}" Watermark="V0" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="U1" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedRegion.U1, Mode=TwoWay, Converter={StaticResource DoubleText}}" Watermark="U1" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="V1" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedRegion.V1, Mode=TwoWay, Converter={StaticResource DoubleText}}" Watermark="V1" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="Default Width" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedRegion.DefaultWidth, Mode=TwoWay, Converter={StaticResource DoubleText}}" Watermark="Default W" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Default Height" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedRegion.DefaultHeight, Mode=TwoWay, Converter={StaticResource DoubleText}}" Watermark="Default H" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Header="Instance Editor">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add" Click="OnAddInstanceClick" />
                <Button Content="Remove" Command="{Binding RemoveInstanceCommand}" />
                <TextBlock Text="Instance" VerticalAlignment="Center" Foreground="#B0B0B0" />
                <ComboBox ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance}"
                          MinWidth="160">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="Name" Foreground="#B0B0B0" />
                <TextBox Text="{Binding SelectedInstance.Name, Mode=TwoWay}" Watermark="Name" />
              </StackPanel>
              <TextBlock Text="Atlas" Foreground="#B0B0B0" />
              <ComboBox ItemsSource="{Binding Atlases}"
                        SelectedItem="{Binding SelectedInstanceAtlas}"
                        MinWidth="160">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Region" Foreground="#B0B0B0" />
              <ComboBox ItemsSource="{Binding SelectedInstanceAtlas.Regions}"
                        SelectedItem="{Binding SelectedInstanceRegion}"
                        MinWidth="160">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Id}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <StackPanel Orientation="Vertical" Spacing="2">
                  <TextBlock Text="Attach Slot" VerticalAlignment="Center" Foreground="#B0B0B0" />
                  <ComboBox ItemsSource="{Binding AttachSlotOptions}"
                            SelectedItem="{Binding SelectedInstanceAttachSlot}"
                            Width="80">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Vertical" Spacing="2">
                  <TextBlock Text="Attachment" VerticalAlignment="Center" Foreground="#B0B0B0" />
                  <ComboBox ItemsSource="{Binding AttachAttachmentOptions}"
                            SelectedItem="{Binding SelectedInstanceAttachment}"
                            Width="80">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <CheckBox IsChecked="{Binding SelectedInstance.AttachUseYaw}" Content="Use Yaw" VerticalAlignment="Bottom"/>
                <CheckBox IsChecked="{Binding SelectedInstance.AttachUsePitch}" Content="Use Pitch" VerticalAlignment="Bottom"/>
                <CheckBox IsChecked="{Binding SelectedInstance.AttachUseRoll}" Content="Use Roll" VerticalAlignment="Bottom"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="Pos X" Foreground="#B0B0B0" />
                  <controls:ScrubbyNumericField
                      Value="{Binding SelectedInstance.PosX, Mode=TwoWay}"
                      FormatString="0.###"
                      Step="0.1"
                      PixelsPerStep="6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Pos Y" Foreground="#B0B0B0" />
                  <controls:ScrubbyNumericField
                      Value="{Binding SelectedInstance.PosY, Mode=TwoWay}"
                      FormatString="0.###"
                      Step="0.1"
                      PixelsPerStep="6"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Text="Pos Z" Foreground="#B0B0B0" />
                  <controls:ScrubbyNumericField
                      Value="{Binding SelectedInstance.PosZ, Mode=TwoWay}"
                      FormatString="0.###"
                      Step="0.1"
                      PixelsPerStep="6"/>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="Pitch" Foreground="#B0B0B0" />
                  <controls:ScrubbyNumericField
                      Value="{Binding SelectedInstance.Pitch, Mode=TwoWay}"
                      FormatString="0.##"
                      Step="1"
                      PixelsPerStep="6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Yaw" Foreground="#B0B0B0" />
                  <controls:ScrubbyNumericField
                      Value="{Binding SelectedInstance.Yaw, Mode=TwoWay}"
                      FormatString="0.##"
                      Step="1"
                      PixelsPerStep="6"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Text="Roll" Foreground="#B0B0B0" />
                  <controls:ScrubbyNumericField
                      Value="{Binding SelectedInstance.Roll, Mode=TwoWay}"
                      FormatString="0.##"
                      Step="1"
                      PixelsPerStep="6"/>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="Scale X" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedInstance.ScaleX, Mode=TwoWay, Converter={StaticResource DoubleText}}" Watermark="Scale X" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Scale Y" Foreground="#B0B0B0" />
                  <TextBox Text="{Binding SelectedInstance.ScaleY, Mode=TwoWay, Converter={StaticResource DoubleText}}" Watermark="Scale Y" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Visible" VerticalAlignment="Center" Foreground="#B0B0B0" />
                <ToggleSwitch IsChecked="{Binding SelectedInstance.Visible}" />
                <TextBlock Text="Depth Test" VerticalAlignment="Center" Foreground="#B0B0B0" />
                <ToggleSwitch IsChecked="{Binding SelectedInstance.DepthTest}" />
                <TextBlock Text="Depth Write" VerticalAlignment="Center" Foreground="#B0B0B0" />
                <ToggleSwitch IsChecked="{Binding SelectedInstance.DepthWrite}" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2"
              Background="#222222"
              CornerRadius="6"
              Padding="8,2"
              BorderBrush="#2A2A2A"
              BorderThickness="1">

        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}"
                    Foreground="#8AC6FF"
                    VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">
            <TextBlock Text="Enabled"
                      Foreground="#B0B0B0"
                      VerticalAlignment="Center" />
            <ToggleSwitch IsChecked="{Binding IsEnabled}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
