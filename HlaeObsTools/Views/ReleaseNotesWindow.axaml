<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
        x:Class="HlaeObsTools.Views.ReleaseNotesWindow"
        Icon="/Assets/icons/app.ico"
        Width="900"
        Height="700"
        MinWidth="500"
        MinHeight="350"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Margin="20" RowSpacing="16">
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <md:MarkdownRenderer x:Name="ReleaseNotesRenderer" />
        </ScrollViewer>
        <Button Grid.Row="1"
                Content="Close"
                Width="88"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="CloseDialog" />
    </Grid>
</Window>
