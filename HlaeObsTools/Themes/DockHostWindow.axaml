<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Dock.Model.Controls;assembly=Dock.Model"
                    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
                    xmlns:dockProps="clr-namespace:Dock.Settings;assembly=Dock.Settings"
                    xmlns:local="using:HlaeObsTools.Views"
                    x:CompileBindings="True"
                    x:DataType="controls:IRootDock">
    <IntLessThanConverter x:Key="LessThan2" TrueIfLessThan="2" />

    <ControlTheme x:Key="{x:Type local:DockHostWindow}" TargetType="local:DockHostWindow">
        <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding Id}" />
        <Setter Property="(AutomationProperties.Name)" Value="{Binding Title}" />
        <Setter Property="(dockProps:DockProperties.IsDragEnabled)" Value="{Binding CanDrag}" />
        <Setter Property="(dockProps:DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
        <Setter Property="(dockProps:DockProperties.DockGroup)" Value="{Binding DockGroup}" />
        <Setter Property="Background" Value="{DynamicResource DockSurfaceEditorBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        <Setter Property="(TextElement.FontSize)" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource DockTabForegroundBrush}" />
        <Setter Property="WindowState" Value="Normal" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Title" Value="{Binding FocusedDockable.Title}" />
        <Setter Property="Topmost" Value="{Binding Window.Topmost}" />
        <Setter Property="WindowDecorations" Value="Full" />
        <Setter Property="ToolChromeControlsWholeWindow" Value="{Binding OpenedDockablesCount, Converter={StaticResource LessThan2}}" />
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                    <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
                    <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
                    <VisualLayerManager Name="PART_VisualLayerManager">
                        <DeferredContentPresenter Name="PART_ContentPresenter"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </VisualLayerManager>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="Content" Value="{Binding}" />
        <Setter Property="ContentTemplate">
            <DataTemplate x:DataType="controls:IRootDock">
                <Panel Margin="{Binding $parent[local:DockHostWindow].OffScreenMargin}">
                    <Panel Margin="{Binding $parent[local:DockHostWindow].WindowDecorationMargin}">
                        <Grid>
                                <dock:DockControl Layout="{Binding}" />
                                <Grid IsHitTestVisible="False"
                                      Panel.ZIndex="9999">
                                    <Canvas Name="PART_HotkeyOverlayCanvas">
                                        <Border Name="PART_HotkeyHoverOutline"
                                                IsVisible="False"
                                                BorderBrush="#FF4CC2FF"
                                                BorderThickness="2"
                                                Background="#334CC2FF"
                                                CornerRadius="4" />
                                    </Canvas>
                                    <Border Name="PART_HotkeyStatusPanel"
                                            IsVisible="False"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#E6191C22"
                                            BorderBrush="#FF4CC2FF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6">
                                        <TextBlock Name="PART_HotkeyStatusText"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   Text="Hotkey mode" />
                                    </Border>
                                </Grid>
                        </Grid>
                    </Panel>
                </Panel>
            </DataTemplate>
        </Setter>

        <Style Selector="^:documentwindow">
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />

            <Style Selector="^:documentchromecontrolswindow">
                <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
                <Setter Property="WindowDecorations" Value="BorderOnly" />
            </Style>
        </Style>

        <Style Selector="^:toolwindow">
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />

            <Style Selector="^:toolchromecontrolswindow">
                <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
                <Setter Property="WindowDecorations" Value="BorderOnly" />
            </Style>

            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                        <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
                        <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
                        <VisualLayerManager Name="PART_VisualLayerManager">
                            <DeferredContentPresenter Name="PART_ContentPresenter"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Content="{TemplateBinding Content}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </VisualLayerManager>
                    </Panel>
                </ControlTemplate>
            </Setter>

            <Setter Property="Content" Value="{Binding}" />
            <Setter Property="ContentTemplate">
                <DataTemplate x:DataType="controls:IRootDock">
                    <Panel Margin="{Binding $parent[local:DockHostWindow].OffScreenMargin}">
                        <Grid>
                                <dock:DockControl Layout="{Binding}" />
                                <Grid IsHitTestVisible="False"
                                      Panel.ZIndex="9999">
                                    <Canvas Name="PART_HotkeyOverlayCanvas">
                                        <Border Name="PART_HotkeyHoverOutline"
                                                IsVisible="False"
                                                BorderBrush="#FF4CC2FF"
                                                BorderThickness="2"
                                                Background="#334CC2FF"
                                                CornerRadius="4" />
                                    </Canvas>
                                    <Border Name="PART_HotkeyStatusPanel"
                                            IsVisible="False"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#E6191C22"
                                            BorderBrush="#FF4CC2FF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6">
                                        <TextBlock Name="PART_HotkeyStatusText"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   Text="Hotkey mode" />
                                    </Border>
                                </Grid>
                        </Grid>
                    </Panel>
                </DataTemplate>
            </Setter>
        </Style>

        <Style Selector="^:toolwindow">
            <Setter Property="Background" Value="{DynamicResource DockSurfaceEditorBrush}" />
            <Setter Property="TransparencyLevelHint" Value="None" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <Style Selector="^:toolwindow:dragging">
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="TransparencyLevelHint" Value="Transparent" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
